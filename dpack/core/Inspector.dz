# dpack/core/Inspector.dz
# Utilities for verifying and inspecting dpack-bundled executables.
#
# Developer: Harizi Riyadh (hariziriyadh@gmail.com)

use file
use path
use dir
use bytes
use os
use env
use math
use random
use process

# Magic: last 8 bytes of the exe = uint64 LE offset of the ZIP from file start

fn readU64LE(buf)
    # buf is an array of 8 byte values
    let v = 0
    let i = 0
    while i < 8
        v = v + (buf[i] * (256 ** i))
        i += 1
    end
    return v
end

# ── verify(exePath) ─────────────────────────────────────────────────────────
# Checks if a file is a valid dpack bundle.
# Returns: {"valid": Bool, "reason": String, "zipOffset": Number, "zipSize": Number}
fn verify(exePath)
    let result = {"valid": False, "reason": "", "zipOffset": 0, "zipSize": 0}

    if !file.exists(exePath)
        result["reason"] = "File not found: " + exePath
        return result
    end

    let size = file.size(exePath)
    if size < 9
        result["reason"] = "File too small to be a valid dpack bundle."
        return result
    end

    # Read last 8 bytes to get ZIP offset
    let allBytes = file.readBytes(exePath)
    let totalBytes = allBytes.length()

    if totalBytes < 8
        result["reason"] = "Could not read file bytes."
        return result
    end

    # Extract last 8 bytes
    let offsetBuf = []
    let i = totalBytes - 8
    while i < totalBytes
        offsetBuf.append(allBytes[i])
        i += 1
    end

    let zipOffset = readU64LE(offsetBuf)
    let zipSize = totalBytes - zipOffset - 8

    if zipOffset == 0 or zipOffset >= totalBytes or zipSize <= 0
        result["reason"] = "No valid dpack bundle found in this file."
        return result
    end

    # Check ZIP magic bytes: PK\x03\x04
    if allBytes[zipOffset] != 80 or allBytes[zipOffset + 1] != 75
        result["reason"] = "Embedded data does not appear to be a ZIP archive."
        return result
    end

    result["valid"] = True
    result["reason"] = "Valid dpack bundle."
    result["zipOffset"] = zipOffset
    result["zipSize"] = zipSize
    return result
end

# ── inspect(exePath) ─────────────────────────────────────────────────────────
# Lists all files bundled inside a packed executable.
# Returns an array of {"path": String, "size": Number}
fn inspect(exePath)
    let check = verify(exePath)
    if !check["valid"]
        throw "dpack inspect: " + check["reason"]
    end

    # Extract the ZIP to a temp dir and list contents
    let tmpDir = ""
    if os.isWindows()
        tmpDir = path.join(env.getOr("TEMP", "C:\\Windows\\Temp"), "dpack_inspect_" + str(random.int(10000, 99999)))
    else
        tmpDir = "/tmp/dpack_inspect_" + str(random.int(10000, 99999))
    end

    dir.createAll(tmpDir)

    # Write the ZIP portion to a temp file
    let allBytes = file.readBytes(exePath)
    let zipOffset = check["zipOffset"]
    let zipSize   = check["zipSize"]

    let zipBytes  = allBytes.slice(zipOffset, zipOffset + zipSize)
    let tmpZip    = path.join(tmpDir, "bundle.zip")
    let handle    = file.open(tmpZip, "wb")
    handle.writeBytes(zipBytes)
    handle.close()

    # Extract using system tool
    if os.isWindows()
        let winZip = tmpZip.replace("/", "\\").replace("'", "''")
        let winDest = tmpDir.replace("/", "\\").replace("'", "''")
        process.exec("powershell -NoProfile -Command \"Expand-Archive -Path '" + winZip + "' -DestinationPath '" + winDest + "' -Force\"")
    else
        process.exec("unzip -q -o \"" + tmpZip + "\" -d \"" + tmpDir + "\"")
    end

    file.delete(tmpZip)

    # Recursively list all files
    let fileList = []
    fn listRecursive(baseDir, prefix)
        let items = dir.list(baseDir)
        for item in items
            let fullPath = path.join(baseDir, item)
            let arcPath = if prefix == "" ? item else prefix + "/" + item
            if file.isDir(fullPath)
                listRecursive(fullPath, arcPath)
            else
                let sz = file.size(fullPath)
                fileList.append({"path": arcPath, "size": sz})
            end
        end
    end
    listRecursive(tmpDir, "")

    # Cleanup
    let items = dir.list(tmpDir)
    for item in items
        let p = path.join(tmpDir, item)
        if file.isDir(p)
            dir.deleteAll(p)
        else
            file.delete(p)
        end
    end
    dir.deleteAll(tmpDir)

    return fileList
end
