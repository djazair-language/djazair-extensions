# dpack — Djazair Self-Contained Executable Packer
#
# Usage:
#   djazair dpack/init.dz pack <script.dz> [options]
#   dpm pack <script.dz> [options]
#
# Options:
#   -o, --output <name>        Output file name (default: script name without .dz)
#   --include <ext>            Force-include an extension by name (repeatable)
#   --quiet                    Suppress verbose output
#   -h, --help                 Show help
#   -v, --version              Show version
#
# Developer: Harizi Riyadh (hariziriyadh@gmail.com)

use process
use file
use path
use dir
use os
use math
use env
use json

import "core/Packer.dz"   as PackerMod
import "core/Inspector.dz" as Inspector

let DPACK_VERSION = "1.1.0"

fn printHelp()
    print("")
    print("\033[1;32mdpack\033[0m v" + DPACK_VERSION + " — Djazair Standalone Executable Packer")
    print("")
    print("Usage:")
    print("  dpack pack <script.dz> [options]    Pack a script into an executable")
    print("  dpack clean                          Clean cached application build folders")
    print("  dpack verify <app.exe>              Verify if an EXE is a valid dpack bundle")
    print("  dpack inspect <app.exe>             List all files inside a packed EXE")
    print("")
    print("Options:")
    print("  -o, --output <name>     Output file name")
    print("  --no-console            Build as GUI app (hide console window)")
    print("  --portable              Portable mode (extract cache next to EXE)")
    print("  --encrypt               Encrypt bundled source scripts")
    print("  --include <ext>         Force-include an extension")
    print("  --quiet                 Suppress build output")
    print("  -h, --help              Show help")
    print("  -v, --version           Show version")
    print("")
    print("Examples:")
    print("  dpack pack main.dz")
    print("  dpack pack main.dz -o app.exe --no-console --encrypt")
    print("  dpack clean")
    print("")
end

fn printVersion()
    print("dpack v" + DPACK_VERSION)
end

fn defaultOutputName(scriptPath)
    let base = path.basename(scriptPath)
    if base.endsWith(".dz")
        base = base.slice(0, base.length() - 3)
    end
    if os.isWindows()
        if !base.endsWith(".exe")
            base = base + ".exe"
        end
    end
    return path.join(path.dirname(scriptPath), base)
end

let Packer = PackerMod.Packer

# Convenience function for packing a script programmatically.
fn pack(scriptPath = Null, outputPath = Null, options = {})
    # ── Load dpack.json if present ───────────────────────────────────────
    let configPath = path.join(process.cwd(), "dpack.json")
    if !file.exists(configPath) and !isNull(scriptPath)
        let scriptDirConfig = path.join(path.dirname(path.resolve(scriptPath)), "dpack.json")
        if file.exists(scriptDirConfig)
            configPath = scriptDirConfig
        end
    end

    if file.exists(configPath)
        try
            let cfgStr = file.read(configPath)
            let cfg = json.decode(cfgStr)
            if type(cfg) == "Map" or type(cfg) == "Object" or type(cfg) == "Dictionary"
                if isNull(scriptPath) and cfg.has("main")
                    scriptPath = cfg["main"]
                end
                if isNull(outputPath) and cfg.has("output")
                    outputPath = cfg["output"]
                end
                # Merge config keys into options (options takes precedence)
                let keys = cfg.keys()
                for k in keys
                    if !options.has(k)
                        options[k] = cfg[k]
                    end
                end
            end
        catch err
            print("  Warning: Failed to parse dpack.json: " + str(err))
        end
    end

    if isNull(scriptPath)
        throw "dpack: No entry script provided, and no 'main' found in dpack.json."
    end

    let absScript = path.resolve(scriptPath)
    if !file.exists(absScript)
        let altScript = path.join(process.scriptDir(), scriptPath)
        if file.exists(altScript)
            absScript = path.resolve(altScript)
        end
    end

    if isNull(outputPath)
        outputPath = defaultOutputName(absScript)
    else
        if !path.isAbsolute(outputPath)
            outputPath = path.resolve(path.join(process.scriptDir(), outputPath))
        end
    end
    
    let p = new Packer(options)
    p.pack(absScript, outputPath, options)
end

# Cleans up cached dpack build folders from system TEMP directory.
fn cleanCache()
    let tmpDir = ""
    if os.isWindows()
        tmpDir = env.getOr("TEMP", "C:\\Windows\\Temp")
    else
        tmpDir = env.getOr("TMPDIR", "/tmp")
    end

    if !file.exists(tmpDir)
        print("Temp directory not found.")
        return
    end

    let items = dir.list(tmpDir)
    let cleanedCount = 0
    let cleanedBytes = 0

    for item in items
        if item.startsWith("dpack_app_") or item.startsWith("dpack_inspect_") or item == ".dpack_stage_tmp"
            let p = path.join(tmpDir, item)
            if file.isDir(p)
                try
                    let sz = 0
                    fn calcSize(d)
                        let list = dir.list(d)
                        let total = 0
                        for it in list
                            let child = path.join(d, it)
                            if file.isDir(child)
                                total += calcSize(child)
                            else
                                total += file.size(child)
                            end
                        end
                        return total
                    end
                    sz = calcSize(p)
                    dir.deleteAll(p)
                    cleanedCount += 1
                    cleanedBytes += sz
                catch e
                    # Skip if currently locked
                end
            end
        end
    end

    let szStr = ""
    if cleanedBytes < 1048576
        szStr = str(math.floor(cleanedBytes / 1024)) + " KB"
    else
        szStr = str(math.floor(cleanedBytes / 1048576)) + " MB"
    end

    print("")
    print("  ✓  Cleaned " + str(cleanedCount) + " cached dpack folder(s) (" + szStr + " freed)")
    print("")
end

# Checks whether a file is a valid dpack bundle.
fn verify(exePath)
    if !path.isAbsolute(exePath)
        exePath = path.resolve(path.join(process.scriptDir(), exePath))
    end
    return Inspector.verify(exePath)
end

# Lists all files bundled inside a packed executable.
fn inspect(exePath)
    if !path.isAbsolute(exePath)
        exePath = path.resolve(path.join(process.scriptDir(), exePath))
    end
    let fileList = Inspector.inspect(exePath)

    print("")
    print("  Contents of: " + path.basename(exePath))
    print("  ------------------------------------")
    for f in fileList
        let sz = f["size"]
        let szStr = ""
        if sz < 1024
            szStr = str(sz) + " B"
        elif sz < 1048576
            szStr = str(math.floor(sz / 1024)) + " KB"
        else
            szStr = str(math.floor(sz / 1048576)) + " MB"
        end
        print("  " + f["path"] + "  (" + szStr + ")")
    end
    print("  ------------------------------------")
    print("  Total: " + str(fileList.length()) + " files")
    print("")
    return fileList
end

# ── CLI Entry Point ──────────────────────────────────────────────────────────
let args = process.args()
if args.length() > 0
    let cmd = args[0]
    if cmd == "clean"
        cleanCache()
    elif cmd == "verify" and args.length() > 1
        let v = verify(args[1])
        print("Valid: " + str(v["valid"]) + " (" + v["reason"] + ")")
    elif cmd == "inspect" and args.length() > 1
        inspect(args[1])
    elif cmd == "-v" or cmd == "--version"
        printVersion()
    elif cmd == "-h" or cmd == "--help"
        printHelp()
    elif cmd == "pack" or cmd.endsWith(".dz")
        let script = if cmd == "pack" ? (if args.length() > 1 ? args[1] else Null) else cmd
        let opts = {}
        let outName = Null
        
        let i = 0
        while i < args.length()
            let a = args[i]
            if (a == "-o" or a == "--output") and i + 1 < args.length()
                outName = args[i + 1]
                i += 1
            elif a == "--no-console"
                opts["console"] = False
            elif a == "--portable"
                opts["portable"] = True
            elif a == "--encrypt" or a == "--protect"
                opts["encrypt"] = True
            elif a == "--quiet"
                opts["quiet"] = True
            end
            i += 1
        end

        pack(script, outName, opts)
    end
end
