# 02_form_layout.dz — Registration QFormLayout with QGridLayout Layout in Djazair Qt
use qt

let app = new qt.QApplication()

let window = new qt.QMainWindow()
window.setTitle("User Registration QFormLayout")
window.resize(450, 350)

let grid = new qt.QGridLayout()

let lblName = new qt.QLabel("Full Name:")
let inputName = new qt.QLineEdit()

let lblEmail = new qt.QLabel("Email Address:")
let inputEmail = new qt.QLineEdit()

let lblPass = new qt.QLabel("Password:")
let inputPass = new qt.QLineEdit()

let btnSubmit = new qt.QPushButton("Register Now")
btnSubmit.setStyleSheet("background-color: #2ecc71; color: white; font-size: 14px; font-weight: bold; padding: 10px;")

grid.addWidget(lblName, 0, 0)
grid.addWidget(inputName, 0, 1)

grid.addWidget(lblEmail, 1, 0)
grid.addWidget(inputEmail, 1, 1)

grid.addWidget(lblPass, 2, 0)
grid.addWidget(inputPass, 2, 1)

grid.addWidget(btnSubmit, 3, 0, 1, 2)

let container = new qt.QWidget()
container.setLayout(grid)

window.setCentralWidget(container)
window.show()

app.exec()


