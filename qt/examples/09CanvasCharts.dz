# 09_canvas_charts.dz — Drawing QCanvas & Charts Demo
use qt

let app = new qt.QApplication()

let win = new qt.QMainWindow()
win.setTitle("QCanvas & Charts Demo")
win.resize(800, 600)

let central = new qt.QWidget()
let mainLayout = new qt.QVBoxLayout(central)

# Part 1: QCanvas (QPixmap + QPainter)
let canvasLabel = new qt.QLabel("QCanvas loaded")
let pix = new qt.QPixmap(400, 200)
pix.fill("#2d2d2d")
let painter = new qt.QPainter(pix)
painter.setPen("#ff6b6b", 3)
painter.drawLine(50, 50, 350, 50)
painter.setBrush("#4ecdc4")
painter.drawRect(100, 80, 200, 80)
painter.setPen("#ffe66d", 2)
painter.drawEllipse(150, 100, 100, 60)
painter.setPen("#ffffff", 1)
painter.drawText(10, 180, "Djazair QCanvas")
painter.endPaint()
canvasLabel.setPixmap(pix)
mainLayout.addWidget(canvasLabel)

# Part 2: QChart (QLineSeries)
let chartLabel = new qt.QLabel("Line QChart")
let chartView = new qt.QChartView()
let chart = new qt.QChart()
chart.setTitle("Sample Line QChart")
let series = new qt.QLineSeries()
series.append(0, 3)
series.append(1, 7)
series.append(2, 4)
series.append(3, 9)
series.append(4, 6)
chart.addSeries(series)
chart.createDefaultAxes()
chartView.setChart(chart)
mainLayout.addWidget(chartView)

# Part 3: Pie QChart
let pieChartLabel = new qt.QLabel("Pie QChart")
let pieView = new qt.QChartView()
let pieChart = new qt.QChart()
pieChart.setTitle("Distribution")
let pieSeries = new qt.QPieSeries()
pieSeries.append("Apples", 30)
pieSeries.append("Bananas", 20)
pieSeries.append("Cherries", 15)
pieSeries.append("Dates", 10)
pieChart.addSeries(pieSeries)
pieView.setChart(pieChart)
mainLayout.addWidget(pieView)

win.setCentralWidget(central)
win.show()
app.exec()


