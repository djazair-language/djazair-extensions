# 03_tree_and_table.dz — Multi-Column Tree and Table Data QGridLayout in Djazair Qt
use qt

let app = new qt.QApplication()

let window = new qt.QMainWindow()
window.setTitle("Djazair Data Explorer")
window.resize(900, 550)

let theme = new qt.Theme()
theme.applyDark(window)

let splitter = new qt.QSplitter(0)

let tree = new qt.QTreeWidget()
tree.setHeaders(["Component", "Status", "Version"])
let root1 = tree.addItem(["Core Compiler", "Active", "v1.0.0"])
tree.addItem(["Scanner / Lexer", "OK", "v1.0.0"], root1)
tree.addItem(["Parser / AST", "OK", "v1.0.0"], root1)

let table = new qt.QTableWidget(4, 3)
table.setItem(0, 0, "sqlite")
table.setItem(0, 1, "Database")
table.setItem(0, 2, "0.1.0")

table.setItem(1, 0, "qt")
table.setItem(1, 1, "GUI Framework")
table.setItem(1, 2, "1.0.0")

splitter.addWidget(tree)
splitter.addWidget(table)

window.setCentralWidget(splitter)
window.show()

app.exec()

