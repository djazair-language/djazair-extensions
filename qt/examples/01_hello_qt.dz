# 01_hello_qt.dz — Hello World GUI Window in Djazair Qt
use qt

let app = new qt.Application()

let window = new qt.MainWindow()
window.setWindowTitle("Djazair Qt — Hello World")
window.resize(500, 300)

let label = new qt.Label("Welcome to Djazair Enterprise Qt!")
let btn = new qt.Button("Click Me")

let vbox = new qt.VBoxLayout()
vbox.setMargins(20, 20, 20, 20)
vbox.setSpacing(10)
vbox.addWidget(label)
vbox.addWidget(btn)

let container = new qt.Widget()
container.setLayout(vbox)

let theme = new qt.Theme()
theme.applyLight(window)

window.setCentralWidget(container)
window.show()

app.exec()
