# 09_canvas_charts.dz — Drawing Canvas & Charts Demo
use qt

let app = new qt.Application()

let win = new qt.MainWindow()
win.setTitle("Canvas & Charts Demo")
win.resize(800, 600)

let central = new qt.Widget()
let mainLayout = new qt.VBoxLayout(central)

# Part 1: Canvas (Pixmap + Painter)
let canvasLabel = new qt.Label("Canvas loaded")
let pix = new qt.Pixmap(400, 200)
pix.fill("#2d2d2d")
let painter = new qt.Painter(pix)
painter.setPen("#ff6b6b", 3)
painter.drawLine(50, 50, 350, 50)
painter.setBrush("#4ecdc4")
painter.drawRect(100, 80, 200, 80)
painter.setPen("#ffe66d", 2)
painter.drawEllipse(150, 100, 100, 60)
painter.setPen("#ffffff", 1)
painter.drawText(10, 180, "Djazair Canvas")
painter.endPaint()
canvasLabel.setPixmap(pix)
mainLayout.addWidget(canvasLabel)

# Part 2: Chart (LineSeries)
let chartLabel = new qt.Label("Line Chart")
let chartView = new qt.ChartView()
let chart = new qt.Chart()
chart.setTitle("Sample Line Chart")
let series = new qt.LineSeries()
series.append(0, 3)
series.append(1, 7)
series.append(2, 4)
series.append(3, 9)
series.append(4, 6)
chart.addSeries(series)
chart.createDefaultAxes()
chartView.setChart(chart)
mainLayout.addWidget(chartView)

# Part 3: Pie Chart
let pieChartLabel = new qt.Label("Pie Chart")
let pieView = new qt.ChartView()
let pieChart = new qt.Chart()
pieChart.setTitle("Distribution")
let pieSeries = new qt.PieSeries()
pieSeries.append("Apples", 30)
pieSeries.append("Bananas", 20)
pieSeries.append("Cherries", 15)
pieSeries.append("Dates", 10)
pieChart.addSeries(pieSeries)
pieView.setChart(pieChart)
mainLayout.addWidget(pieView)

win.setCentralWidget(central)
win.show()
app.exec()
