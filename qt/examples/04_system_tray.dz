# 04_system_tray.dz — Native System Tray Icon Notification App in Djazair Qt
use qt

let app = new qt.Application()

let tray = new qt.SystemTrayIcon("Djazair System Tray Application")
tray.show()

tray.showMessage("Djazair Qt Alert", "Enterprise System Tray Notification Active!", 1, 5000)

app.exec()
