# 02_form_layout.dz — Registration Form with Grid Layout in Djazair Qt
use qt

let app = new qt.Application()

let window = new qt.MainWindow()
window.setTitle("User Registration Form")
window.resize(450, 350)

let grid = new qt.GridLayout()

let lblName = new qt.Label("Full Name:")
let inputName = new qt.LineEdit()

let lblEmail = new qt.Label("Email Address:")
let inputEmail = new qt.LineEdit()

let lblPass = new qt.Label("Password:")
let inputPass = new qt.LineEdit()

let btnSubmit = new qt.Button("Register Now")
btnSubmit.setStyleSheet("background-color: #2ecc71; color: white; font-size: 14px; font-weight: bold; padding: 10px;")

grid.addWidget(lblName, 0, 0)
grid.addWidget(inputName, 0, 1)

grid.addWidget(lblEmail, 1, 0)
grid.addWidget(inputEmail, 1, 1)

grid.addWidget(lblPass, 2, 0)
grid.addWidget(inputPass, 2, 1)

grid.addWidget(btnSubmit, 3, 0, 1, 2)

let container = new qt.Widget()
container.setLayout(grid)

window.setCentralWidget(container)
window.show()

app.exec()
