use qt

let app = new qt.QApplication()

let window = new qt.QMainWindow()
window.setTitle("Djazair Qt - Drag & Drop")
window.resize(400, 300)

let label = new qt.QLabel("", window)
label.setText("Drag and drop files here!")
label.setAlignment(132) # AlignCenter

# Enable drag and drop
label.setAcceptDrops(True)

label.onDrop(fn(urls)
    print(urls)
end)

window.setCentralWidget(label)
window.show()

app.exec()
