# 05_load_ui_file.dz — Dynamic Qt Designer UI Loader Example
use qt
use path
use process

let app = new qt.QApplication()

# Resolve the UI file beside this script, not from the shell's current folder.
let uiPath = path.join(process.scriptDir(), "sample_form.ui")
let window = qt.loadUi(uiPath)

if window != Null
    let theme = new qt.Theme()
    theme.applyDark(window)
    window.show()
    app.exec()
else
    print("[ERROR] Could not locate sample_form.ui file! Please ensure the file exists.")
end
