# 04_system_tray.dz — Native System QSystemTrayIcon Icon Notification App in Djazair Qt
use qt

let app = new qt.QApplication()

let tray = new qt.QSystemTrayIcon("Djazair System QSystemTrayIcon QApplication")
tray.show()

tray.showMessage("Djazair Qt Alert", "Enterprise System QSystemTrayIcon Notification Active!", 1, 5000)

app.exec()


