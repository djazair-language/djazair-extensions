# 01_modern_dashboard.dz — Modern Dark Dashboard in Djazair Qt
use qt

let app = new qt.QApplication()

let window = new qt.QMainWindow()
window.setTitle("Djazair Enterprise Qt Dashboard")
window.resize(900, 600)

let theme = new qt.Theme()
theme.applyDark(window)

let tabs = new qt.QTabWidget()

# Tab 1: Overview
let overviewWidget = new qt.QWidget()
let vbox = new qt.QVBoxLayout()

let groupMetrics = new qt.QGroupBox("System Metrics")
let grid = new qt.QGridLayout()

grid.addWidget(new qt.QLabel("CPU Usage:"), 0, 0)
let cpuBar = new qt.QProgressBar()
cpuBar.setRange(0, 100)
cpuBar.setValue(42)
grid.addWidget(cpuBar, 0, 1)

grid.addWidget(new qt.QLabel("Memory Usage:"), 1, 0)
let memBar = new qt.QProgressBar()
memBar.setRange(0, 100)
memBar.setValue(68)
grid.addWidget(memBar, 1, 1)

groupMetrics.setLayout(grid)
vbox.addWidget(groupMetrics)

let btnRefresh = new qt.QPushButton("Refresh Metrics")
vbox.addWidget(btnRefresh)

overviewWidget.setLayout(vbox)
tabs.addTab(overviewWidget, "System Overview")

# Tab 2: Settings
let settingsWidget = new qt.QWidget()
let form = new qt.QFormLayout()
form.addRow("Username:", new qt.QLineEdit("Riyadh"))
form.addRow("API Server:", new qt.QLineEdit("https://api.djazair.org"))
form.addRow("Auto-save:", new qt.QCheckBox())

settingsWidget.setLayout(form)
tabs.addTab(settingsWidget, "Configuration")

window.setCentralWidget(tabs)
window.setStatusMessage("Dashboard loaded successfully.", 5000)
window.show()

app.exec()


