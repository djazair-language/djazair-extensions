# multimedia/video.dz — Native Qt QVideoWidget Wrapper
let _qt = __dynamic("qt")

import "../widgets/base.dz" as baseMod

let QWidget = baseMod.QWidget

class QVideoWidget is QWidget
    init(parent = Null)
        let parentHandle = Null
        if parent != Null
            parentHandle = parent.handle
        end
        self.handle = _qt.videowidgetCreate(parentHandle)
    end
end

