# multimedia/player.dz — Native Qt QMediaPlayer Wrapper
let _qt = __dynamic("qt")

class MediaPlayer
    init()
        self.handle = _qt.mediaplayerCreate()
    end

    setMedia(fileOrUrl)
        _qt.mediaplayerSetMedia(self.handle, fileOrUrl)
    end

    play()
        _qt.mediaplayerPlay(self.handle)
    end

    pause()
        _qt.mediaplayerPause(self.handle)
    end

    stop()
        _qt.mediaplayerStop(self.handle)
    end

    setVideoOutput(videoWidget)
        _qt.mediaplayerSetVideoOutput(self.handle, videoWidget.handle)
    end
end
