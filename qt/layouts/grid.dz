# layouts/grid.dz — 2D QGridLayout Layout Manager
let _qt = __dynamic("qt")

class QGridLayout
    init(parent = Null)
        let parentHandle = Null
        if parent != Null
            parentHandle = parent.handle
        end
        self.handle = _qt.gridCreate(parentHandle)
    end

    addWidget(widget, row, col, rowSpan = 1, colSpan = 1)
        _qt.gridAddWidget(self.handle, widget.handle, row, col, rowSpan, colSpan)
    end

    addLayout(childLayout)
        _qt.layoutAddLayout(self.handle, childLayout.handle)
    end

    setMargins(left, top, right, bottom)
        _qt.layoutSetMargins(self.handle, left, top, right, bottom)
    end

    setSpacing(spacing)
        _qt.layoutSetSpacing(self.handle, spacing)
    end
end



