# window/tray.dz — Native QSystemTrayIcon Wrapper
let _qt = __dynamic("qt")

class QSystemTrayIcon
    init(tooltip = "Djazair QApplication")
        self.handle = _qt.trayCreate(tooltip)
    end

    show()
        _qt.trayShow(self.handle)
    end

    hide()
        _qt.trayHide(self.handle)
    end

    setIcon(iconPath)
        _qt.traySetIcon(self.handle, iconPath)
    end

    setContextMenu(menu)
        _qt.traySetMenu(self.handle, menu.handle)
    end

    showMessage(title, message, iconType = 1, timeout = 5000)
        _qt.trayShowMessage(self.handle, title, message, iconType, timeout)
    end
end



