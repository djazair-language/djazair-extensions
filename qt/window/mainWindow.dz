# window/main_window.dz — Enterprise QMainWindow, MenuBar, QMenu, and QAction
let _qt = __dynamic("qt")

class QAction
    init(handle)
        self.handle = handle
    end
end

class QToolBar
    init(handle)
        self.handle = handle
    end

    addAction(title)
        _qt.toolbarAddAction(self.handle, title)
    end
end

class QMenu
    init(handle)
        self.handle = handle
    end

    addMenu(title)
        let handle = _qt.menuAddSubmenu(self.handle, title)
        if handle == Null
            return Null
        end
        return new QMenu(handle)
    end

    addAction(title)
        let handle = _qt.menuAddAction(self.handle, title)
        if handle == Null
            return Null
        end
        return new QAction(handle)
    end

    addSeparator()
        _qt.menuAddSeparator(self.handle)
    end
end

class QMainWindow
    init()
        self.handle = _qt.mainwindowCreate()
    end

    setCentralWidget(widget)
        _qt.mainwindowSetCentral(self.handle, widget.handle)
    end

    setTitle(title)
        _qt.mainwindowSetTitle(self.handle, title)
    end

    setWindowTitle(title)
        _qt.mainwindowSetTitle(self.handle, title)
    end

    resize(width, height)
        _qt.mainwindowResize(self.handle, width, height)
    end

    show()
        _qt.mainwindowShow(self.handle)
    end

    addMenu(title)
        let handle = _qt.mainwindowAddMenu(self.handle, title)
        if handle == Null
            return Null
        end
        return new QMenu(handle)
    end

    addToolBar(title)
        let handle = _qt.mainwindowAddToolBar(self.handle, title)
        return new QToolBar(handle)
    end

    setStatusMessage(message, timeout = 3000)
        _qt.mainwindowSetStatus(self.handle, message, timeout)
    end
end



