# window/dialogs.dz — QMessageBox, QFileDialog, and QInputDialog Modals
let _qt = __dynamic("qt")

class QMessageBox
    info(title, message)
        _qt.messageboxInfo(title, message)
    end

    warning(title, message)
        _qt.messageboxWarning(title, message)
    end

    error(title, message)
        _qt.messageboxError(title, message)
    end

    question(title, message)
        return _qt.messageboxQuestion(title, message)
    end
end

class QFileDialog
    getOpenFileName(title = "Open File", filter = "All Files (*.*)")
        return _qt.filedialogOpen(title, filter)
    end

    getSaveFileName(title = "Save File", filter = "All Files (*.*)")
        return _qt.filedialogSave(title, filter)
    end

    getExistingDirectory(title = "Select Directory")
        return _qt.filedialogGetDirectory(title)
    end
end

class QInputDialog
    getText(title, label)
        return _qt.inputdialogGetText(title, label)
    end
end



