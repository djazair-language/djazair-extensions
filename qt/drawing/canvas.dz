# drawing/canvas.dz — Double-buffered drawing area widget
let _qt = __dynamic("qt")

import "../widgets/base.dz" as baseMod
import "painter.dz" as painterMod

let QWidget = baseMod.QWidget
let QPainter = painterMod.QPainter

class QCanvas is QWidget
    init(parent = Null)
        let parentHandle = Null
        if parent != Null
            parentHandle = parent.handle
        end
        self.handle = _qt.canvasCreate(parentHandle)
    end

    begin()
        let h = _qt.canvasBegin(self.handle)
        if h == Null
            return Null
        end
        let p = QPainter()
        p.handle = h
        return p
    end

    endPaint()
        _qt.canvasEnd(self.handle)
    end

    clear(color_hex = "#ffffff")
        _qt.canvasClear(self.handle, color_hex)
    end

    setSize(w, h)
        _qt.canvasSetSize(self.handle, w, h)
    end
end

