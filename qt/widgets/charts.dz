# widgets/charts.dz
let _qt = __dynamic("qt")

import "base.dz" as baseMod
let QWidget = baseMod.QWidget

class QChart
    init()
        self.handle = _qt.chartCreate()
    end

    setTitle(title)
        _qt.chartSetTitle(self.handle, title)
    end

    addSeries(series)
        _qt.chartAddSeries(self.handle, series.handle)
    end

    createDefaultAxes()
        _qt.chartCreateDefaultAxes(self.handle)
    end

    setAxisTitle(orientation, title)
        # orientation: 0 = Horizontal (X), 1 = Vertical (Y)
        _qt.chartSetAxisTitle(self.handle, orientation, title)
    end

    setAxisRange(orientation, min, max)
        # orientation: 0 = Horizontal (X), 1 = Vertical (Y)
        _qt.chartSetAxisRange(self.handle, orientation, min, max)
    end
end

class QChartView is QWidget
    init(parent = Null)
        let parentHandle = Null
        if parent != Null
            parentHandle = parent.handle
        end
        self.handle = _qt.chartviewCreate(parentHandle)
    end

    setChart(chart)
        _qt.chartviewSetChart(self.handle, chart.handle)
    end
end

class QLineSeries
    init()
        self.handle = _qt.lineseriesCreate()
    end

    append(x, y)
        _qt.lineseriesAppend(self.handle, x, y)
    end
end

class QPieSeries
    init()
        self.handle = _qt.pieseriesCreate()
    end

    append(label, value)
        _qt.pieseriesAppend(self.handle, label, value)
    end
end

class QBarSet
    init(label)
        self.handle = _qt.barsetCreate(label)
    end

    append(value)
        _qt.barsetAppend(self.handle, value)
    end
end

class QBarSeries
    init()
        self.handle = _qt.barseriesCreate()
    end

    append(barset)
        _qt.barseriesAppend(self.handle, barset.handle)
    end
end

class QScatterSeries
    init()
        self.handle = _qt.scatterseriesCreate()
    end

    append(x, y)
        _qt.scatterseriesAppend(self.handle, x, y)
    end
end


