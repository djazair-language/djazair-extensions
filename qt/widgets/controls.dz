# widgets/controls.dz — Buttons & Input Controls
let _qt = __dynamic("qt")

import "base.dz" as baseMod

let Widget = baseMod.Widget

class Button is Widget
    init(text = "", parent = Null)
        let parentHandle = Null
        if parent != Null
            parentHandle = parent.handle
        end
        self.handle = _qt.buttonCreate(text, parentHandle)
    end

    setText(text)
        _qt.buttonSetText(self.handle, text)
    end
end

class Label is Widget
    init(text = "", parent = Null)
        let parentHandle = Null
        if parent != Null
            parentHandle = parent.handle
        end
        self.handle = _qt.labelCreate(text, parentHandle)
    end

    setText(text)
        _qt.labelSetText(self.handle, text)
    end

    getText()
        return _qt.labelGetText(self.handle)
    end
end

class CheckBox is Widget
    init(text = "", parent = Null)
        let parentHandle = Null
        if parent != Null
            parentHandle = parent.handle
        end
        self.handle = _qt.checkboxCreate(text, parentHandle)
    end
end

class RadioButton is Widget
    init(text = "", parent = Null)
        let parentHandle = Null
        if parent != Null
            parentHandle = parent.handle
        end
        self.handle = _qt.radiobuttonCreate(text, parentHandle)
    end
end

class ProgressBar is Widget
    init(parent = Null)
        let parentHandle = Null
        if parent != Null
            parentHandle = parent.handle
        end
        self.handle = _qt.progressbarCreate(parentHandle)
    end

    setRange(min, max)
        _qt.progressbarSetRange(self.handle, min, max)
    end

    setValue(val)
        _qt.progressbarSetValue(self.handle, val)
    end
end

class Slider is Widget
    init(orientation = 0, parent = Null)
        let parentHandle = Null
        if parent != Null
            parentHandle = parent.handle
        end
        self.handle = _qt.sliderCreate(orientation, parentHandle)
    end

    setRange(min, max)
        _qt.sliderSetRange(self.handle, min, max)
    end

    setValue(val)
        _qt.sliderSetValue(self.handle, val)
    end
end

class SpinBox is Widget
    init(parent = Null)
        let parentHandle = Null
        if parent != Null
            parentHandle = parent.handle
        end
        self.handle = _qt.spinboxCreate(parentHandle)
    end

    setRange(min, max)
        _qt.spinboxSetRange(self.handle, min, max)
    end
end
