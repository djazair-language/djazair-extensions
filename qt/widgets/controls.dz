# widgets/controls.dz — Enterprise GUI Controls (QPushButton, QLabel, QCheckBox, Radio, QProgressBar, QSlider, QSpinBox)
let _qt = __dynamic("qt")

import "base.dz" as baseMod

let QWidget = baseMod.QWidget

class QPushButton is QWidget
    init(text = "", parent = Null)
        let parentHandle = Null
        if parent != Null
            parentHandle = parent.handle
        end
        self.handle = _qt.buttonCreate(text, parentHandle)
    end

    setText(text)
        _qt.buttonSetText(self.handle, text)
    end

    onClicked(callback)
        _qt.buttonOnClicked(self.handle, callback)
    end
end

class QLabel is QWidget
    init(text = "", parent = Null)
        let parentHandle = Null
        if parent != Null
            parentHandle = parent.handle
        end
        self.handle = _qt.labelCreate(text, parentHandle)
    end

    setText(text)
        _qt.labelSetText(self.handle, text)
    end

    setAlignment(align_flag)
        _qt.labelSetAlignment(self.handle, align_flag)
    end

    setPixmap(pixmap)
        _qt.labelSetPixmap(self.handle, pixmap.handle)
    end

    getText()
        return _qt.labelGetText(self.handle)
    end
end

class QCheckBox is QWidget
    init(text = "", parent = Null)
        let parentHandle = Null
        if parent != Null
            parentHandle = parent.handle
        end
        self.handle = _qt.checkboxCreate(text, parentHandle)
    end

    isChecked()
        return _qt.checkboxIsChecked(self.handle)
    end

    setChecked(checked)
        _qt.checkboxSetChecked(self.handle, checked)
    end

    onToggled(callback)
        _qt.checkboxOnToggled(self.handle, callback)
    end
end

class QRadioButton is QWidget
    init(text = "", parent = Null)
        let parentHandle = Null
        if parent != Null
            parentHandle = parent.handle
        end
        self.handle = _qt.radiobuttonCreate(text, parentHandle)
    end

    setChecked(checked)
        _qt.radiobuttonSetChecked(self.handle, checked)
    end

    isChecked()
        return _qt.radiobuttonIsChecked(self.handle)
    end
end

class QProgressBar is QWidget
    init(parent = Null)
        let parentHandle = Null
        if parent != Null
            parentHandle = parent.handle
        end
        self.handle = _qt.progressbarCreate(parentHandle)
    end

    setRange(minVal, maxVal)
        _qt.progressbarSetRange(self.handle, minVal, maxVal)
    end

    setValue(val)
        _qt.progressbarSetValue(self.handle, val)
    end

    getValue()
        return _qt.progressbarGetValue(self.handle)
    end
end

class QSlider is QWidget
    init(orient = 0, parent = Null)
        let parentHandle = Null
        if parent != Null
            parentHandle = parent.handle
        end
        self.handle = _qt.sliderCreate(orient, parentHandle)
    end

    setRange(minVal, maxVal)
        _qt.sliderSetRange(self.handle, minVal, maxVal)
    end

    setValue(val)
        _qt.sliderSetValue(self.handle, val)
    end

    getValue()
        return _qt.sliderGetValue(self.handle)
    end

    onValueChanged(callback)
        _qt.sliderOnValueChanged(self.handle, callback)
    end
end

class QDoubleSpinBox is QWidget
    init(parent = Null)
        let parentHandle = Null
        if parent != Null
            parentHandle = parent.handle
        end
        self.handle = _qt.doublespinboxCreate(parentHandle)
    end

    setRange(minVal, maxVal)
        _qt.doublespinboxSetRange(self.handle, minVal, maxVal)
    end

    getValue()
        return _qt.doublespinboxGetValue(self.handle)
    end

    setValue(val)
        _qt.doublespinboxSetValue(self.handle, val)
    end

    setDecimals(prec)
        _qt.doublespinboxSetDecimals(self.handle, prec)
    end
end

class QSpinBox is QWidget
    init(parent = Null)
        let parentHandle = Null
        if parent != Null
            parentHandle = parent.handle
        end
        self.handle = _qt.spinboxCreate(parentHandle)
    end

    setRange(minVal, maxVal)
        _qt.spinboxSetRange(self.handle, minVal, maxVal)
    end

    getValue()
        return _qt.spinboxGetValue(self.handle)
    end

    setValue(val)
        _qt.spinboxSetValue(self.handle, val)
    end

    onChange(callback)
        _qt.spinboxOnChange(self.handle, callback)
    end
end


