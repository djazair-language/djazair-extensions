# widgets/base.dz — Base QWidget OOP Wrapper
let _qt = __dynamic("qt")

class QWidget
    init(parent = Null, nativeHandle = Null)
        if nativeHandle != Null
            self.handle = nativeHandle
            return
        end

        let parentHandle = Null
        if parent != Null
            parentHandle = parent.handle
        end
        self.handle = _qt.widgetCreate(parentHandle)
    end

    show()
        _qt.widgetShow(self.handle)
    end

    hide()
        _qt.widgetHide(self.handle)
    end

    setVisible(visible)
        if visible
            _qt.widgetShow(self.handle)
        else
            _qt.widgetHide(self.handle)
        end
    end

    setTitle(title)
        _qt.widgetSetTitle(self.handle, title)
    end

    setWindowTitle(title)
        _qt.widgetSetTitle(self.handle, title)
    end

    setGeometry(x, y, w, h)
        _qt.widgetSetGeometry(self.handle, x, y, w, h)
    end

    resize(w, h)
        _qt.widgetResize(self.handle, w, h)
    end

    setLayout(layout)
        _qt.widgetSetLayout(self.handle, layout.handle)
    end

    setStyleSheet(css)
        _qt.widgetSetStyleSheet(self.handle, css)
    end

    setEnabled(enabled)
        _qt.widgetSetEnabled(self.handle, enabled)
    end

    setToolTip(text)
        _qt.widgetSetToolTip(self.handle, text)
    end

    update()
        _qt.widgetUpdate(self.handle)
    end

    destroy()
        _qt.widgetDestroy(self.handle)
        self.handle = Null
    end

    setAcceptDrops(accept)
        _qt.widgetSetAcceptDrops(self.handle, accept)
    end

    onDrop(callback)
        _qt.widgetOnDrop(self.handle, callback)
    end
end
