# widgets/views.dz — Complex Data QGridLayout & View Widgets (QListWidget, QTreeWidget, QTableWidget, QTreeWidgetItem)
let _qt = __dynamic("qt")

import "base.dz" as baseMod

let QWidget = baseMod.QWidget

class QTreeWidgetItem
    init(handle)
        self.handle = handle
    end
end

class QListWidget is QWidget
    init(parent = Null)
        let parentHandle = Null
        if parent != Null
            parentHandle = parent.handle
        end
        self.handle = _qt.listwidgetCreate(parentHandle)
    end

    addItem(text)
        _qt.listwidgetAddItem(self.handle, text)
    end

    getCurrentItemText()
        return _qt.listwidgetGetCurrentItemText(self.handle)
    end

    clear()
        _qt.listwidgetClear(self.handle)
    end
end

class QTreeWidget is QWidget
    init(parent = Null)
        let parentHandle = Null
        if parent != Null
            parentHandle = parent.handle
        end
        self.handle = _qt.treewidgetCreate(parentHandle)
    end

    setHeaders(headers)
        _qt.treewidgetSetHeaders(self.handle, headers, headers.length())
    end

    addItem(columnsArray, parentItem = Null)
        let parentHandle = Null
        if parentItem != Null
            parentHandle = parentItem.handle
        end
        let handle = _qt.treewidgetAddItem(self.handle, columnsArray, parentHandle)
        if handle == Null
            return Null
        end
        return new QTreeWidgetItem(handle)
    end
end

class QTableWidget is QWidget
    init(rows = 0, cols = 0, parent = Null)
        let parentHandle = Null
        if parent != Null
            parentHandle = parent.handle
        end
        self.handle = _qt.tablewidgetCreate(rows, cols, parentHandle)
    end

    setItem(row, col, text)
        _qt.tablewidgetSetItem(self.handle, row, col, text)
    end

    setSize(rows, cols)
        _qt.tablewidgetSetSize(self.handle, rows, cols)
    end

    setHeaders(headers)
        _qt.tablewidgetSetHeaders(self.handle, headers)
    end

    getItem(row, col)
        return _qt.tablewidgetGetItem(self.handle, row, col)
    end
end


