# widgets/inputs.dz — User Input Widgets (QLineEdit, QTextEdit, QComboBox)
let _qt = __dynamic("qt")

import "base.dz" as baseMod

let QWidget = baseMod.QWidget

class QLineEdit is QWidget
    init(text = "", parent = Null)
        let parentHandle = Null
        if parent != Null
            parentHandle = parent.handle
        end
        self.handle = _qt.lineeditCreate(text, parentHandle)
    end

    setText(text)
        _qt.lineeditSetText(self.handle, text)
    end

    getText()
        return _qt.lineeditGetText(self.handle)
    end

    setPlaceholder(text)
        _qt.lineeditSetPlaceholder(self.handle, text)
    end

    setEchoMode(mode)
        _qt.lineeditSetEchoMode(self.handle, mode)
    end

    onChange(callback)
        _qt.lineeditOnChange(self.handle, callback)
    end
end

class QTextEdit is QWidget
    init(text = "", parent = Null)
        let parentHandle = Null
        if parent != Null
            parentHandle = parent.handle
        end
        self.handle = _qt.texteditCreate(text, parentHandle)
    end

    setText(text)
        _qt.texteditSetText(self.handle, text)
    end

    getText()
        return _qt.texteditGetText(self.handle)
    end

    clear()
        _qt.texteditClear(self.handle)
    end

    append(text)
        _qt.texteditAppend(self.handle, text)
    end

    onChange(callback)
        _qt.texteditOnChange(self.handle, callback)
    end
end

class QPlainTextEdit is QWidget
    init(text = "", parent = Null)
        let parentHandle = Null
        if parent != Null
            parentHandle = parent.handle
        end
        self.handle = _qt.plaintexteditCreate(text, parentHandle)
    end

    append(text)
        _qt.plaintexteditAppend(self.handle, text)
    end

    clear()
        _qt.plaintexteditClear(self.handle)
    end

    getText()
        return _qt.plaintexteditGetText(self.handle)
    end

    setReadOnly(ro)
        _qt.plaintexteditSetReadOnly(self.handle, ro)
    end
end

class QComboBox is QWidget
    init(parent = Null)
        let parentHandle = Null
        if parent != Null
            parentHandle = parent.handle
        end
        self.handle = _qt.comboboxCreate(parentHandle)
    end

    addItem(text)
        _qt.comboboxAddItem(self.handle, text)
    end

    getCurrentText()
        return _qt.comboboxGetCurrent(self.handle)
    end

    getCurrentIndex()
        return _qt.comboboxGetCurrentIndex(self.handle)
    end

    setCurrentIndex(idx)
        _qt.comboboxSetCurrentIndex(self.handle, idx)
    end

    onChange(callback)
        _qt.comboboxOnChange(self.handle, callback)
    end
end

