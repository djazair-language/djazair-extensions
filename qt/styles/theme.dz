# styles/theme.dz — Modern Preset Light & Dark Themes
let _qt = __dynamic("qt")

class Theme
    applyDark(widget)
        let darkStyle = "QWidget { background-color: #121212; color: #E0E0E0; font-family: 'Segoe UI', Arial, sans-serif; font-size: 13px; }" +
                        "QPushButton { background-color: #1E1E1E; border: 1px solid #333333; border-radius: 4px; padding: 6px 12px; color: #FFFFFF; }" +
                        "QPushButton:hover { background-color: #007ACC; border-color: #007ACC; }" +
                        "QLineEdit, QTextEdit { background-color: #1E1E1E; border: 1px solid #333333; border-radius: 4px; padding: 4px; color: #FFFFFF; }" +
                        "QTabWidget::pane { border: 1px solid #333333; background: #121212; }" +
                        "QTabBar::tab { background: #1E1E1E; color: #AAAAAA; padding: 8px 16px; border: 1px solid #333333; }" +
                        "QTabBar::tab:selected { background: #007ACC; color: #FFFFFF; font-weight: bold; }"
        _qt.widgetSetStyleSheet(widget.handle, darkStyle)
    end

    applyLight(widget)
        let lightStyle = "QWidget { background-color: #F8F9FA; color: #212529; font-family: 'Segoe UI', Arial, sans-serif; font-size: 13px; }" +
                         "QPushButton { background-color: #FFFFFF; border: 1px solid #CED4DA; border-radius: 4px; padding: 6px 12px; color: #212529; }" +
                         "QPushButton:hover { background-color: #0D6EFD; color: #FFFFFF; border-color: #0D6EFD; }" +
                         "QLineEdit, QTextEdit { background-color: #FFFFFF; border: 1px solid #CED4DA; border-radius: 4px; padding: 4px; color: #212529; }" +
                         "QTabWidget::pane { border: 1px solid #CED4DA; background: #FFFFFF; }" +
                         "QTabBar::tab { background: #E9ECEF; color: #495057; padding: 8px 16px; border: 1px solid #CED4DA; }" +
                         "QTabBar::tab:selected { background: #0D6EFD; color: #FFFFFF; font-weight: bold; }"
        _qt.widgetSetStyleSheet(widget.handle, lightStyle)
    end
end


