# init.dz — Enterprise Public Exports for Qt Framework Extension

import "core/app.dz" as appMod
import "core/timer.dz" as timerMod
import "core/uiloader.dz" as uiMod
import "multimedia/player.dz" as playerMod
import "multimedia/video.dz" as videoMod
import "widgets/base.dz" as baseMod
import "widgets/controls.dz" as ctrlMod
import "widgets/inputs.dz" as inputMod
import "widgets/containers.dz" as containerMod
import "widgets/views.dz" as viewMod
import "layouts/vbox.dz" as vboxMod
import "layouts/hbox.dz" as hboxMod
import "layouts/grid.dz" as gridMod
import "layouts/form.dz" as formMod
import "window/mainWindow.dz" as winMod
import "window/dialog.dz" as dlgMod
import "window/dialogs.dz" as dialogMod
import "window/tray.dz" as trayMod
import "styles/theme.dz" as themeMod
import "drawing/painter.dz" as painterMod
import "drawing/canvas.dz" as canvasMod
import "widgets/charts.dz" as chartMod

let QApplication = appMod.QApplication
let QTimer       = timerMod.QTimer
let loadUi      = uiMod.loadUi

let QMediaPlayer = playerMod.QMediaPlayer
let QVideoWidget = videoMod.QVideoWidget

let QWidget      = baseMod.QWidget

let QPushButton      = ctrlMod.QPushButton
let QLabel       = ctrlMod.QLabel
let QCheckBox    = ctrlMod.QCheckBox
let QRadioButton = ctrlMod.QRadioButton
let QProgressBar = ctrlMod.QProgressBar
let QSlider      = ctrlMod.QSlider
let QSpinBox     = ctrlMod.QSpinBox
let QDoubleSpinBox = ctrlMod.QDoubleSpinBox

let QLineEdit    = inputMod.QLineEdit
let QTextEdit    = inputMod.QTextEdit
let QPlainTextEdit = inputMod.QPlainTextEdit
let QComboBox    = inputMod.QComboBox

let QTabWidget    = containerMod.QTabWidget
let QStackedWidget= containerMod.QStackedWidget
let QGroupBox     = containerMod.QGroupBox
let QScrollArea   = containerMod.QScrollArea
let QSplitter     = containerMod.QSplitter

let QListWidget  = viewMod.QListWidget
let QTreeWidget  = viewMod.QTreeWidget
let QTreeWidgetItem    = viewMod.QTreeWidgetItem
let QTableWidget = viewMod.QTableWidget

let QVBoxLayout  = vboxMod.QVBoxLayout
let QHBoxLayout  = hboxMod.QHBoxLayout
let QGridLayout  = gridMod.QGridLayout
let QFormLayout  = formMod.QFormLayout

let QMainWindow  = winMod.QMainWindow
let QMenu        = winMod.QMenu
let QAction      = winMod.QAction
let QToolBar     = winMod.QToolBar
let QDialog      = dlgMod.QDialog
# Dialog helpers are stateless facade instances so documented calls such as
# qt.QMessageBox.info("title", "message") work without `new`.
let QMessageBox  = new dialogMod.QMessageBox()
let QFileDialog  = new dialogMod.QFileDialog()
let QInputDialog = new dialogMod.QInputDialog()
let QSystemTrayIcon = trayMod.QSystemTrayIcon

let Theme       = themeMod.Theme

let QPixmap      = painterMod.QPixmap
let QPainter     = painterMod.QPainter
let pixmapLoad  = painterMod.pixmapLoad
let QCanvas      = canvasMod.QCanvas

let QChart       = chartMod.QChart
let QChartView   = chartMod.QChartView
let QLineSeries  = chartMod.QLineSeries
let QPieSeries   = chartMod.QPieSeries
let QBarSet      = chartMod.QBarSet
let QBarSeries   = chartMod.QBarSeries
let QScatterSeries = chartMod.QScatterSeries


