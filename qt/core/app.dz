# core/app.dz — Qt QApplication Lifecycle Manager for Djazair
let _qt = __dynamic("qt")

class QApplication
    init()
        self.handle = _qt.appCreate()
    end

    exec()
        return _qt.appExec(self.handle)
    end

    processEvents()
        _qt.appProcessEvents(self.handle)
    end

    setStyle(styleName)
        _qt.appSetStyle(styleName)
    end

    quit()
        _qt.appQuit(self.handle)
    end

    destroy()
        _qt.appDestroy(self.handle)
        self.handle = Null
    end
end
