# assets.dz
# Embedded asset resolver for webview JavaScript client scripts
# Author: Harizi Riyadh (hariziriyadh@gmail.com)
# Copyright (c) 2026 Djazair Language Project

use file
use path
use process
use lang

# Reads a webview embedded asset (e.g. bridge_client.js) reliably
# by searching across the standard library extension location, local script directory,
# and common asset paths.
fn readWebviewAsset(name)
    let sDir = process.scriptDir()
    let lDir = lang.libsDir()
    let candidates = [
        # Search in global packages directory (lang.libsDir)
        path.join(lDir, "webview", "bridge", "js", name),
        path.join(lDir, "webview", "js", name),
        path.join(lDir, "webview", name),
        # Search in local djazair_packages directory (dpm install)
        path.join(sDir, "djazair_packages", "webview", "bridge", "js", name),
        path.join(sDir, "djazair_packages", "webview", "js", name),
        path.join(sDir, "djazair_packages", "webview", name),
        # Search relative to script directory (development layout)
        path.join(sDir, "bridge", "js", name),
        path.join(sDir, "js", name),
        path.join(sDir, "assets", "js", name),
        path.join(sDir, "..", "bridge", "js", name),
        name
    ]
    for candidate in candidates
        if file.exists(candidate)
            return file.read(candidate)
        end
    end
    throw "WebviewAssetError: cannot find asset '" + name + "'"
end
