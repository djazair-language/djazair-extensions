# Kasbah Core — sessionManager class
# High-level interface for reading and writing session data within a request handler.
# Automatically attached to req.session and res.session by the session middleware.

import "../helpers/utils.dz" as *
use crypto

class sessionManager
    init(data, sid, isNew, store = Null, response = Null, cookieOptions = {})
        self.sessionData    = data
        self.sessionId      = sid
        self.isNewSession   = isNew
        self.needsNewCookie = False
        self.storeRef       = store
        self.responseRef    = response
        self.cookieOptions  = cookieOptions
    end

    # Returns the value for a session key, or fallback if absent.
    get(key, fallback = Null)
        if self.sessionData.has(key)
            return self.sessionData[key]
        end
        return fallback
    end

    # Sets a key-value pair in the session.
    set(key, value)
        self.sessionData[key] = value
        return self
    end

    # Deletes a key from the session.
    delete(key)
        if self.sessionData.has(key)
            self.sessionData.delete(key)
        end
        return self
    end

    # Returns True if the key exists in the session.
    has(key)
        return self.sessionData.has(key)
    end

    # Returns a shallow copy map of all session data.
    all()
        let result = {}
        for k, v in self.sessionData
            result[k] = v
        end
        return result
    end

    # Clears all keys in the session data.
    clear()
        let keys = self.sessionData.keys()
        for k in keys
            self.sessionData.delete(k)
        end
        return self
    end

    # Returns True if this session was created for the current request.
    isNew()
        return self.isNewSession
    end

    # Returns the unique session ID.
    id()
        return self.sessionId
    end

    # Generates a new session ID and immediately queues a replacement cookie.
    # Doing this here matters because a handler may send its response before the
    # post-request session save occurs.
    regenerate()
        let previousId = self.sessionId
        self.sessionId      = generateId(32)
        self.isNewSession   = True
        self.needsNewCookie = True
        if !isNull(self.storeRef)
            self.storeRef.destroy(previousId)
        end
        if !isNull(self.responseRef)
            let secret = self.cookieOptions["secret"]
            let token = "${self.sessionId}.${crypto.sha256("${secret}:${self.sessionId}")}"
            self.responseRef.cookie(self.cookieOptions["name"], token, self.cookieOptions["attributes"])
        end
        return self.sessionId
    end

    # Internal: returns the raw session data map.
    rawData()
        return self.sessionData
    end

    # Internal: returns the raw session ID.
    rawId()
        return self.sessionId
    end
end
