# Kasbah Core — kasbahRequest class
# Wraps built-in httpRequest with params, query, cookies, session, state.

use file
import "validator.dz" as *
import "fileManager.dz" as *

class kasbahRequest
    init(httpReq)
        self.method     = httpReq.method
        self.path       = httpReq.pathname
        self.rawHeaders = httpReq.headers
        self.body       = httpReq.body
        self.httpObj    = httpReq

        self.params   = {}
        self.cookies  = {}
        self.session  = {}
        self.ip       = ""
        self.files    = {}
        self.stateMap = {}
        self.queryMap = {}
        if !isNull(httpReq.query)
            for pair in httpReq.query.entries()
                self.queryMap[pair[0]] = pair[1]
            end
        end
    end

    # Returns an uploaded file wrapper by form field name.
    file(name)
        if self.files.has(name) && !isNull(self.files[name])
            let info = self.files[name]
            if isArray(info)
                if info.length() == 0
                    return Null
                end
                info = info[0]
            end
            return new uploadedFile(info)
        end
        return Null
    end

    # Returns True if an uploaded file exists for the form field name AND its temp file is on disk.
    hasFile(name)
        if !self.files.has(name) || isNull(self.files[name])
            return False
        end
        let info = self.files[name]
        if isArray(info)
            if info.length() == 0
                return False
            end
            info = info[0]
        end
        if isMap(info) && info.has("tempPath")
            return file.exists(info["tempPath"])
        end
        return False
    end

    # Instantiates a file manager for handling upload validation and saving.
    uploader(options = {})
        return new fileManager(self, options)
    end

    # Instantiates an input validator for data validation.
    validate(data = Null)
        let d = data
        if isNull(d)
            d = if isMap(self.body) ? self.body else {}
        end
        return new validator(d)
    end

    # Returns a URL path parameter by name, or fallback if absent.
    param(name, fallback = Null)
        if self.params.has(name)
            return self.params[name]
        end
        return fallback
    end

    # Returns a query string parameter by name, or fallback if absent.
    # Call with no arguments to get the full query map.
    query(name = Null, fallback = Null)
        if isNull(name)
            return self.queryMap
        end
        if self.queryMap.has(name)
            return self.queryMap[name]
        end
        return fallback
    end

    # Returns an HTTP request header by name (case-insensitive).
    header(name)
        return self.httpObj.header(name)
    end

    # Returns a cookie value by name, or Null if not found.
    # Works with both a plain Map (before prepareRequest) and a cookieJar object (at runtime).
    cookie(name)
        if isMap(self.cookies)
            if self.cookies.has(name)
                return self.cookies[name]
            end
            return Null
        end
        # cookieJar object assigned by kasbahApp.prepareRequest()
        return self.cookies.get(name)
    end

    # Gets a custom request state value (set by middleware).
    get(key)
        if self.stateMap.has(key)
            return self.stateMap[key]
        end
        return Null
    end

    # Sets a custom request state value (used by middleware).
    set(key, value)
        self.stateMap[key] = value
        return self
    end

    # Checks if the request method matches (case-insensitive).
    isMethod(method)
        return self.httpObj.isMethod(method)
    end

    # Returns True if the client Accept header is compatible with the given media type.
    # Handles wildcards (*/*), type-wildcards (image/*), and quality factors (;q=0.9).
    # Examples: req.accepts("application/json"), req.accepts("text/html"), req.accepts("image/*")
    accepts(type)
        let accept = self.httpObj.header("accept")
        if accept == "" || accept == "*/*"
            return True
        end
        let parts = accept.split(",")
        for part in parts
            let mediaRange = part.split(";")[0].strip()
            if mediaRange == "*/*"
                return True
            end
            if mediaRange == type
                return True
            end
            # Handle type-wildcard: "image/*" matches "image/png"
            if mediaRange.endsWith("/*")
                let prefix = mediaRange.slice(0, mediaRange.length() - 2)
                if type.startsWith("${prefix}/")
                    return True
                end
            end
        end
        return False
    end

    # Merges and returns all input data (URL params + query params + request body).
    inputs()
        let result = {}
        for k, v in self.params
            result[k] = v
        end
        for k, v in self.queryMap
            result[k] = v
        end
        if isMap(self.body)
            for k, v in self.body
                result[k] = v
            end
        end
        return result
    end

    # Gets a specific input value from params, query, or body (in order of priority).
    input(name, fallback = Null)
        if self.params.has(name)
            return self.params[name]
        end
        if self.queryMap.has(name)
            return self.queryMap[name]
        end
        if isMap(self.body) && self.body.has(name)
            return self.body[name]
        end
        return fallback
    end

    # Returns a map containing only the specified input keys.
    only(keys)
        let all = self.inputs()
        let result = {}
        for k in keys
            if all.has(k)
                result[k] = all[k]
            end
        end
        return result
    end

    # Returns a map containing all input keys except the specified ones.
    except(keys)
        let all = self.inputs()
        let skip = {}
        for k in keys
            skip[k] = True
        end
        let result = {}
        for k, v in all
            if !skip.has(k)
                result[k] = v
            end
        end
        return result
    end

    # Returns True if the request was made via AJAX (X-Requested-With: XMLHttpRequest).
    isAjax()
        return self.httpObj.header("x-requested-with") == "XMLHttpRequest"
    end

    # Checks if the request Content-Type matches the given type ("json", "form", "multipart").
    contentIs(type)
        let ct = self.httpObj.header("content-type")
        if isNull(ct) || ct == ""
            return False
        end
        if type == "json"
            return ct.contains("application/json")
        end
        if type == "form"
            return ct.contains("application/x-www-form-urlencoded")
        end
        if type == "multipart"
            return ct.contains("multipart/form-data")
        end
        return ct.contains(type)
    end
end
