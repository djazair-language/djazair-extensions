# Kasbah Core — kasbahRequest class
# Wraps built-in httpRequest with params, query, cookies, session, state.

import "validator.dz" as *
import "fileManager.dz" as *

class kasbahRequest
    init(httpReq)
        self.method     = httpReq.method
        self.path       = httpReq.pathname
        self.rawHeaders = httpReq.headers
        self.body       = httpReq.body
        self.httpObj    = httpReq

        self.params   = {}
        self.cookies  = {}
        self.session  = {}
        self.ip       = ""
        self.files    = {}
        self.stateMap = {}
        self.queryMap = {}
        if !isNull(httpReq.query)
            for pair in httpReq.query.entries()
                self.queryMap[pair[0]] = pair[1]
            end
        end
    end

    # Returns an uploaded file wrapper by form field name.
    file(name)
        if self.files.has(name) && !isNull(self.files[name])
            let info = self.files[name]
            if isArray(info)
                if info.length() == 0
                    return Null
                end
                info = info[0]
            end
            return new uploadedFile(info)
        end
        return Null
    end

    # Returns True if an uploaded file exists for the form field name.
    hasFile(name)
        return self.files.has(name) && !isNull(self.files[name])
    end

    # Instantiates a file manager for handling upload validation and saving.
    uploader(options = {})
        return new fileManager(self, options)
    end

    # Instantiates an input validator for data validation.
    validate(data = Null)
        let d = data
        if isNull(d)
            d = if isMap(self.body) ? self.body else {}
        end
        return new validator(d)
    end

    # Returns a URL path parameter by name.
    param(name)
        if self.params.has(name)
            return self.params[name]
        end
        return Null
    end

    # Returns a query string parameter by name, or all query parameters if name is Null.
    query(name = Null)
        if isNull(name)
            return self.queryMap
        end
        if self.queryMap.has(name)
            return self.queryMap[name]
        end
        return Null
    end

    # Returns an HTTP request header by name (case-insensitive).
    header(name)
        return self.httpObj.header(name)
    end

    # Returns a cookie value by name.
    cookie(name)
        if isMap(self.cookies) && self.cookies.has(name)
            return self.cookies[name]
        end
        return Null
    end

    # Gets a custom request state value (set by middleware).
    get(key)
        if self.stateMap.has(key)
            return self.stateMap[key]
        end
        return Null
    end

    # Sets a custom request state value (used by middleware).
    set(key, value)
        self.stateMap[key] = value
        return self
    end

    # Checks if the request method matches (case-insensitive).
    isMethod(method)
        return self.httpObj.isMethod(method)
    end

    # Checks if the request Accept header matches the given media type.
    accepts(type)
        let accept = self.httpObj.header("accept")
        if accept == ""
            return True
        end
        return accept.contains(type)
    end

    # Merges and returns all input data (URL params + query params + request body).
    inputs()
        let result = {}
        for k, v in self.params
            result[k] = v
        end
        for k, v in self.queryMap
            result[k] = v
        end
        if isMap(self.body)
            for k, v in self.body
                result[k] = v
            end
        end
        return result
    end

    # Gets a specific input value from params, query, or body (in order of priority).
    input(name, fallback = Null)
        if self.params.has(name)
            return self.params[name]
        end
        if self.queryMap.has(name)
            return self.queryMap[name]
        end
        if isMap(self.body) && self.body.has(name)
            return self.body[name]
        end
        return fallback
    end

    # Returns a map containing only the specified input keys.
    only(keys)
        let all = self.inputs()
        let result = {}
        for k in keys
            if all.has(k)
                result[k] = all[k]
            end
        end
        return result
    end

    # Returns a map containing all input keys except the specified ones.
    except(keys)
        let all = self.inputs()
        let skip = {}
        for k in keys
            skip[k] = True
        end
        let result = {}
        for k, v in all
            if !skip.has(k)
                result[k] = v
            end
        end
        return result
    end

    # Returns True if the request was made via AJAX (X-Requested-With: XMLHttpRequest).
    isAjax()
        return self.httpObj.header("x-requested-with") == "XMLHttpRequest"
    end

    # Checks if the request Content-Type matches the given type ("json", "form", "multipart").
    contentIs(type)
        let ct = self.httpObj.header("content-type")
        if isNull(ct) || ct == ""
            return False
        end
        if type == "json"
            return ct.contains("application/json")
        end
        if type == "form"
            return ct.contains("application/x-www-form-urlencoded")
        end
        if type == "multipart"
            return ct.contains("multipart/form-data")
        end
        return ct.contains(type)
    end
end
