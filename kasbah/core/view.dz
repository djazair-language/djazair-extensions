# Kasbah Core — View class
# Handles reading HTML templates and injecting dynamic variables.

use file
use path
import "../helpers/utils.dz" as *

class view
    init(config)
        self.configMap = config
    end

    # Renders an HTML template file with data interpolation and XSS escaping.
    # Interpolation syntax:
    #   {{ key }}   - Escaped HTML output
    #   {{{ key }}} - Raw HTML output
    render(templateName, data = {})
        let viewsDir = ""
        if self.configMap.has("views") && self.configMap["views"] != ""
            viewsDir = path.normalize(self.configMap["views"])
        else
            viewsDir = path.resolve("views")
        end

        if !templateName.contains(".")
            templateName = "${templateName}.html"
        end

        let safePath = path.normalize("${viewsDir}/${templateName}")

        let viewsDirLower = viewsDir.lower()
        if !viewsDirLower.endsWith("/") && !viewsDirLower.endsWith("\\")
            let okSlash = safePath.lower().startsWith("${viewsDirLower}/")
            let okBackslash = safePath.lower().startsWith("${viewsDirLower}\\")
            if !okSlash && !okBackslash
                throw "Forbidden view path traversal: ${templateName}"
            end
        else
            if !safePath.lower().startsWith(viewsDirLower)
                throw "Forbidden view path traversal: ${templateName}"
            end
        end

        if !file.exists(safePath)
            throw "View not found: ${templateName}"
        end

        let content = ""
        let fh = file.open(safePath, "r")
        try
            content = fh.read()
        catch err
            throw "Error reading view file: ${templateName}"
        finally
            fh.close()
        end

        if isMap(data)
            for k, v in data
                let rawVal = str(v)
                let escapedVal = escapeHtml(rawVal)
                
                content = content.replace("{{{${k}}}}", rawVal)
                content = content.replace("{{{ ${k} }}}", rawVal)
                
                content = content.replace("{{${k}}}", escapedVal)
                content = content.replace("{{ ${k} }}", escapedVal)
            end
        end

        return content
    end
end
