# Kasbah Core — kasbahResponse class
# Wraps the built-in httpResponse with a fluent, high-level API.

use json as *
use http
use file
use path
use bytes
import "../helpers/cookie.dz" as *
import "../helpers/utils.dz" as *
import "view.dz" as *

class kasbahResponse
    init(httpRes, appConfig = {})
        self.httpObj    = httpRes
        self.statusCode = 200
        self.headersMap = {}
        self.cookieList = []
        self.sentFlag   = False
        self.configMap  = appConfig
        self.cookies    = Null
        self.session    = Null
        self.req        = Null
    end

    # Sets the HTTP response status code.
    status(code)
        self.statusCode = code
        self.httpObj.status(code)
        return self
    end

    # Sets an HTTP response header (case-insensitive key).
    setHeader(name, value)
        if !isValidHttpToken(name)
            return self
        end
        let headerValue = str(value)
        if headerValue.contains("\r") || headerValue.contains("\n")
            return self
        end
        self.headersMap[name.lower()] = headerValue
        return self
    end

    # Fluent getter/setter for HTTP response headers.
    header(name, value = Null)
        if !isNull(value)
            return self.setHeader(name, value)
        end
        if self.headersMap.has(name.lower())
            return self.headersMap[name.lower()]
        end
        return ""
    end

    # Removes an HTTP response header by name.
    removeHeader(name)
        self.headersMap.delete(name.lower())
        return self
    end

    # Sets status code and sends standard HTTP status text as response body.
    sendStatus(code)
        self.status(code)
        self.text(httpStatusText(code))
        return self
    end

    # Builds the raw Set-Cookie header lines string for all queued cookies.
    buildCookieLines()
        if self.cookieList.length() == 0
            return ""
        end
        let lines = ""
        for c in self.cookieList
            let serialized = serializeCookie(c["name"], c["value"], c["options"])
            if serialized != ""
                lines += "set-cookie: ${serialized}\r\n"
            end
        end
        return lines
    end

    # Injects queued Set-Cookie headers into a raw HTTP response string.
    # headerOnly=False (default): injects before \r\n\r\n and keeps the body.
    # headerOnly=True: used by res.file() which sends the body separately as bytes.
    injectCookies(raw, headerOnly = False)
        let lines = self.buildCookieLines()
        if lines == ""
            return raw
        end
        let sepIdx = raw.index("\r\n\r\n")
        if sepIdx == -1
            return raw
        end
        if headerOnly
            return raw.slice(0, sepIdx) + "\r\n" + lines + "\r\n"
        end
        return raw.slice(0, sepIdx) + "\r\n" + lines + "\r\n" + raw.slice(sepIdx + 4)
    end

    # Sends a raw string body with status line and all queued headers and cookies.
    # Automatically sets byte-accurate Content-Length for keep-alive correctness.
    sendRaw(body)
        if self.sentFlag
            return
        end
        self.sentFlag = True

        # Byte-accurate Content-Length (UTF-8 byte count, not character count)
        if !self.headersMap.has("content-length")
            let bodyBytes = bytes.fromString(body)
            self.headersMap["content-length"] = str(bodyBytes.length())
        end

        let builder = new http.httpResponseBuilder()
        builder.status(self.statusCode)

        for key, val in self.headersMap
            builder.setHeader(key, val)
        end

        let raw = builder.build(body)
        raw = self.injectCookies(raw)
        self.httpObj.sendRaw(raw)
    end

    # Sends string response body.
    send(body)
        self.sendRaw(body)
        return self
    end

    # Sends plain text response body (`text/plain; charset=utf-8`).
    text(body)
        self.setHeader("Content-Type", "text/plain; charset=utf-8")
        return self.send(body)
    end

    # Sends HTML response body (`text/html; charset=utf-8`).
    html(body)
        self.setHeader("Content-Type", "text/html; charset=utf-8")
        return self.send(body)
    end

    # Serializes data as JSON and sends response (`application/json; charset=utf-8`).
    json(data)
        self.setHeader("Content-Type", "application/json; charset=utf-8")
        let strData = encode(data)
        self.sendRaw(strData)
        return self
    end

    # Streams a binary or text file to the client with appropriate MIME type and Content-Length.
    file(filePath)
        let safePath = path.normalize(filePath)

        if !file.exists(safePath)
            self.status(404).send("File not found")
            return self
        end

        if !self.headersMap.has("content-type")
            let ext = path.extname(safePath)
            self.setHeader("Content-Type", mimeType(ext))
        end

        let fileData = file.readBytes(safePath)

        let builder = new http.httpResponseBuilder()
        builder.status(self.statusCode)

        for key, val in self.headersMap
            builder.setHeader(key, val)
        end
        builder.setHeader("Content-Length", str(fileData.length()))

        let headerStr = builder.build("")
        # headerOnly=True: body (fileData) is sent separately as bytes via sendWithBytes
        headerStr = self.injectCookies(headerStr, True)

        self.httpObj.sendWithBytes(headerStr, fileData)
        self.sentFlag = True
        return self
    end

    # Renders an HTML template view and sends it as response.
    view(templateName, data = {})
        try
            let v = new view(self.configMap)
            let content = v.render(templateName, data)
            return self.html(content)
        catch err
            if str(err).startsWith("View not found")
                self.status(404).send("View not found")
            else
                self.status(500).send("Internal Server Error")
            end
            return self
        end
    end

    # Triggers a file download in the browser with Content-Disposition header.
    # Supports non-ASCII filenames (Arabic, Chinese, etc.) via RFC 5987 filename*.
    download(filePath, filename = Null)
        if isNull(filename)
            filename = path.basename(filePath)
        end
        filename = sanitizeFilename(filename)
        if filename == ""
            filename = "download"
        end
        # RFC 5987: filename*=UTF-8'' for modern browsers (handles any Unicode filename)
        # filename= kept as ASCII fallback for legacy clients
        let encodedName = urlEncodeFilename(filename)
        self.setHeader("Content-Disposition",
            "attachment; filename=\"${filename}\"; filename*=UTF-8''${encodedName}")
        return self.file(filePath)
    end

    # Sends a redirect response to the target URL.
    # Rejects URLs containing CRLF sequences to prevent HTTP response splitting.
    redirect(url, code = 302)
        let safeUrl = str(url)
        if safeUrl.contains("\r") || safeUrl.contains("\n")
            self.status(400).text("Bad Request")
            return self
        end
        self.status(code)
        self.setHeader("Location", safeUrl)
        self.sendRaw("")
        return self
    end

    # Queues a Set-Cookie header on the response.
    cookie(name, value, options = {})
        self.cookieList.append({"name": name, "value": value, "options": options})
        return self
    end

    # Queues a Set-Cookie delete header on the response.
    deleteCookie(name)
        return self.cookie(name, "", {
            "maxAge":  0,
            "path":    "/",
            "expires": "Thu, 01 Jan 1970 00:00:00 GMT"
        })
    end

    # Sets Content-Type header by file extension shortcut.
    type(ext)
        if ext.length() > 0 && ext[0] != "."
            ext = ".${ext}"
        end
        if ext.length() == 0
            return self
        end
        self.setHeader("Content-Type", mimeType(ext))
        return self
    end

    # Sets HTTP Link header for Web Linking (RFC 5988).
    links(linkMap)
        let parts = []
        for rel, href in linkMap
            parts.append("<${href}>; rel=\"${rel}\"")
        end
        self.setHeader("Link", parts.join(", "))
        return self
    end

    # ── Semantic Response Helpers ──────────────────────────────────────────────

    # Sends 200 OK. Serializes `data` as JSON if provided, or sends empty body.
    ok(data = Null)
        self.status(200)
        if isNull(data)
            return self.send("")
        end
        return self.json(data)
    end

    # Sends 201 Created. Serializes `data` as JSON if provided, or sends empty body.
    created(data = Null)
        self.status(201)
        if isNull(data)
            return self.send("")
        end
        return self.json(data)
    end

    # Sends 204 No Content with an empty body (used after DELETE or successful updates).
    noContent()
        self.status(204).send("")
        return self
    end

    # Sends 400 Bad Request with a JSON `{"error": message}` body.
    badRequest(message = "Bad Request")
        return self.status(400).json({"error": message})
    end

    # Sends 401 Unauthorized with a JSON `{"error": message}` body.
    unauthorized(message = "Unauthorized")
        return self.status(401).json({"error": message})
    end

    # Sends 403 Forbidden with a JSON `{"error": message}` body.
    forbidden(message = "Forbidden")
        return self.status(403).json({"error": message})
    end

    # Sends 404 Not Found with a JSON `{"error": message}` body.
    notFound(message = "Not Found")
        return self.status(404).json({"error": message})
    end

    # Sends 422 Unprocessable Entity with a JSON `{"errors": errorsMap}` body.
    # Designed to pair directly with the validator: res.validationError(v.errors())
    validationError(errors)
        return self.status(422).json({"errors": errors})
    end

    # Sends 500 Internal Server Error with a JSON `{"error": message}` body.
    serverError(message = "Internal Server Error")
        return self.status(500).json({"error": message})
    end

    # Sets the Content-Type header manually.
    type(mimeType)
        return self.setHeader("Content-Type", mimeType)
    end

    # Sends an XML response.
    xml(body)
        self.type("application/xml")
        return self.send(body)
    end

    # Redirects the client back to their previous location (Referer header), or a fallback URL.
    back(fallback = "/")
        let ref = fallback
        if !isNull(self.req)
            let reqRef = self.req.referer()
            if reqRef != ""
                ref = reqRef
            end
        end
        return self.redirect(ref)
    end
end
