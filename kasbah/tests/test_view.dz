# test_view.dz
# Tests for Kasbah AST template engine (view.dz)

import "../core/view.dz" as viewMod
use process
use file
use dir
use os

let passed = 0
let failed = 0

fn test(name, condition)
    if condition
        print("  PASS: ${name}")
        passed += 1
    else
        print("  FAIL: ${name}")
        failed += 1
    end
end

print("=== Kasbah View Engine Tests ===")

let tmpDir = "${os.tmpDir()}/kasbah_view_tests"
if !file.exists(tmpDir)
    dir.createAll(tmpDir)
end

let cfg = {"views": tmpDir}

fn writeTemplate(name, content)
    file.write("${tmpDir}/${name}", content)
end

fn renderWith(templateName, data = {})
    let v = new viewMod.view(cfg)
    return v.render(templateName, data)
end

# ─────────────────────────────────────────────────────────────────────────────
# PART 1: Variable injection (escaped)
# ─────────────────────────────────────────────────────────────────────────────
print("\n--- PART 1: Variable Injection ---")

writeTemplate("var_test.html", "<p>Hello, {{ name }}!</p>")
let r1 = renderWith("var_test.html", {"name": "Riad"})
test("{{ var }} is substituted", r1 == "<p>Hello, Riad!</p>")

writeTemplate("missing.html", "<p>{{ missing }}</p>")
let r2 = renderWith("missing.html", {})
test("missing variable renders empty", r2 == "<p></p>")

writeTemplate("dot.html", "<p>{{ user.name }}</p>")
let r3 = renderWith("dot.html", {"user": {"name": "Admin"}})
test("dot notation user.name works", r3 == "<p>Admin</p>")

# ─────────────────────────────────────────────────────────────────────────────
# PART 2: XSS escaping
# ─────────────────────────────────────────────────────────────────────────────
print("\n--- PART 2: XSS Escaping ---")

writeTemplate("xss.html", "{{ script }}")
let r4 = renderWith("xss.html", {"script": "<script>alert('xss')</script>"})
test("< is escaped to &lt;", r4.contains("&lt;"))
test("> is escaped to &gt;", r4.contains("&gt;"))
test("original <script> not in output", !r4.contains("<script>"))

writeTemplate("xss_amp.html", "{{ val }}")
let r5 = renderWith("xss_amp.html", {"val": "a & b"})
test("& is escaped to &amp;", r5 == "a &amp; b")

# ─────────────────────────────────────────────────────────────────────────────
# PART 3: Raw output {{{ }}}
# ─────────────────────────────────────────────────────────────────────────────
print("\n--- PART 3: Raw Output ---")

writeTemplate("raw.html", "{{{ html }}}")
let r6 = renderWith("raw.html", {"html": "<b>bold</b>"})
test("{{{ raw }}} outputs unescaped HTML", r6 == "<b>bold</b>")

# ─────────────────────────────────────────────────────────────────────────────
# PART 4: Conditionals
# ─────────────────────────────────────────────────────────────────────────────
print("\n--- PART 4: Conditionals ---")

writeTemplate("if.html", "{% if show %}YES{% endif %}")
let r7 = renderWith("if.html", {"show": True})
test("{% if true %} renders body", r7.contains("YES"))

let r8 = renderWith("if.html", {"show": False})
test("{% if false %} skips body", !r8.contains("YES"))

writeTemplate("ifelse.html", "{% if flag %}A{% else %}B{% endif %}")
let r9 = renderWith("ifelse.html", {"flag": True})
test("{% if true %} chooses A branch", r9.contains("A") && !r9.contains("B"))

let r10 = renderWith("ifelse.html", {"flag": False})
test("{% else %} chooses B branch", r10.contains("B") && !r10.contains("A"))

writeTemplate("ifneg.html", "{% if !hidden %}VISIBLE{% endif %}")
let r11 = renderWith("ifneg.html", {"hidden": False})
test("negated condition !false renders body", r11.contains("VISIBLE"))

let r12 = renderWith("ifneg.html", {"hidden": True})
test("negated condition !true skips body", !r12.contains("VISIBLE"))

# ─────────────────────────────────────────────────────────────────────────────
# PART 5: Loops
# ─────────────────────────────────────────────────────────────────────────────
print("\n--- PART 5: Loops ---")

writeTemplate("for.html", "{% for item in items %}{{ item }}|{% endfor %}")
let r13 = renderWith("for.html", {"items": ["a", "b", "c"]})
test("{% for %} iterates over array", r13 == "a|b|c|")

let r14 = renderWith("for.html", {"items": []})
test("{% for %} on empty array outputs nothing", r14 == "")

writeTemplate("for_obj.html", "{% for u in users %}{{ u.name }},{% endfor %}")
let r15 = renderWith("for_obj.html", {"users": [{"name": "Alice"}, {"name": "Bob"}]})
test("{% for %} with object dot notation works", r15 == "Alice,Bob,")

# ─────────────────────────────────────────────────────────────────────────────
# PART 6: Path traversal guard
# ─────────────────────────────────────────────────────────────────────────────
print("\n--- PART 6: Path Traversal Guard ---")

let traversalBlocked = False
try
    let vv = new viewMod.view(cfg)
    vv.render("../../etc/passwd", {})
catch err
    traversalBlocked = True
end
test("path traversal ../../ is blocked", traversalBlocked)

let traversalBlocked2 = False
try
    let vv = new viewMod.view(cfg)
    vv.render("../init.dz", {})
catch err
    traversalBlocked2 = True
end
test("path traversal ../ is blocked", traversalBlocked2)

# ─────────────────────────────────────────────────────────────────────────────
# PART 7: Auto-append .html extension
# ─────────────────────────────────────────────────────────────────────────────
print("\n--- PART 7: Auto .html extension ---")

writeTemplate("autoext.html", "OK")
let r16 = renderWith("autoext", {})
test("template name without .html resolves correctly", r16 == "OK")

# ─────────────────────────────────────────────────────────────────────────────
# PART 8: Missing template throws
# ─────────────────────────────────────────────────────────────────────────────
print("\n--- PART 8: Missing template ---")

let notFoundThrown = False
try
    renderWith("definitely_does_not_exist", {})
catch err
    notFoundThrown = str(err).startsWith("View not found")
end
test("missing template throws 'View not found'", notFoundThrown)

# ─────────────────────────────────────────────────────────────────────────────
# Summary
# ─────────────────────────────────────────────────────────────────────────────
print("\n=== Results: ${passed} passed, ${failed} failed / ${passed + failed} total ===")
if failed > 0
    process.exit(1)
end
