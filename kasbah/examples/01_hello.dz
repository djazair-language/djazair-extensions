# ═══════════════════════════════════════════════════════════════════════════════
# Kasbah Example 01 — Hello World
# ═══════════════════════════════════════════════════════════════════════════════
# Minimal HTTP web server demonstrating basic response types in Kasbah:
# Plain text, JSON serialization, HTTP status codes, and custom response headers.
#
# Usage:
#   Run: djazair examples/01_hello.dz
#   Endpoints:
#     GET /        -> Plain text ("Hello from Kasbah!")
#     GET /json    -> Structured JSON response
#     GET /status  -> 200 OK via sendStatus()
#     GET /headers -> Custom response headers via res.header()

use kasbah

# Initialize application instance with port 8080
let app = new kasbah.kasbahApp({
    "port": 8080
})

# 1. Plain text endpoint
app.get("/", fn(req, res)
    res.text("Hello from Kasbah!")
end)

# 2. JSON endpoint
app.get("/json", fn(req, res)
    res.json({
        "message": "Hello from Kasbah!",
        "version": "0.2.0",
        "framework": "Kasbah"
    })
end)

# 3. Semantic HTTP status code endpoint
app.get("/status", fn(req, res)
    res.sendStatus(200)
end)

# 4. Custom HTTP headers endpoint
app.get("/headers", fn(req, res)
    res.header("x-powered-by", "Kasbah")
    res.header("x-custom", "hello")
    res.json({"headers": "check response headers"})
end)

# Start server listener
app.listen()
