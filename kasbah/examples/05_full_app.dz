# ═══════════════════════════════════════════════════════════════════════════════
# Kasbah Example 05 — Full-Featured REST Guestbook Application
# ═══════════════════════════════════════════════════════════════════════════════
# Combines core framework capabilities: Routing, dynamic params, JSON body parsing,
# input validation, session management, request logging, and middleware pipelines.
#
# Usage:
#   Run: djazair examples/05_full_app.dz
#   Endpoints:
#     GET  /              -> Application documentation and route map
#     GET  /messages      -> List all guestbook messages
#     POST /messages      -> Submit new message (JSON body: {"text": "...", "author": "..."})
#     GET  /messages/:id  -> Get specific message by numeric index
#     GET  /session       -> View active session metadata and visit count

use kasbah
use datetime

# Initialize application instance with complete middleware stack
let app = new kasbah.kasbahApp({
    "port":          8080,
    "bodyParser":    True,
    "logger":        True,
    "session":       True,
    "sessionSecret": "kasbah-guestbook-secret-key-32-chars-minimum!"
})

# In-memory messages collection
let messages = []

# Global Request Timestamp Middleware
app.middleware(fn(req, res)
    req.set("timestamp", str(datetime.now()))
end)

# 1. API Documentation Index
app.get("/", fn(req, res)
    res.json({
        "app":       "Kasbah Guestbook API",
        "version":   "0.2.0",
        "endpoints": {
            "GET  /":             "API documentation & route directory",
            "GET  /messages":     "List all guestbook entries",
            "POST /messages":     "Create a new entry (JSON body: {\"text\": \"...\"})",
            "GET  /messages/:id": "Retrieve an entry by numeric ID",
            "GET  /session":      "Inspect session state and visit statistics"
        }
    })
end)

# 2. List All Messages
app.get("/messages", fn(req, res)
    res.json({
        "total":    messages.length(),
        "messages": messages
    })
end)

# 3. Create a Message
app.post("/messages", fn(req, res)
    let text = req.input("text")
    let author = req.input("author")

    if isNull(text) or str(text).strip() == ""
        res.status(400).json({"error": "Field 'text' is required and cannot be empty"})
        return
    end

    if isNull(author) or str(author).strip() == ""
        author = "Anonymous"
    end

    let newMsg = {
        "id":        messages.length(),
        "text":      str(text).strip(),
        "author":    str(author).strip(),
        "timestamp": req.get("timestamp")
    }
    messages.append(newMsg)

    res.status(201).json({
        "message": "Message posted successfully",
        "created": newMsg
    })
end)

# 4. Get Message by ID
app.get("/messages/:id", fn(req, res)
    let rawId = req.param("id")
    let idx = 0
    try
        idx = int(rawId)
    catch err
        res.status(400).json({"error": "Parameter ':id' must be a valid integer"})
        return
    end

    if idx < 0 or idx >= messages.length()
        res.status(404).json({"error": "Message with ID ${idx} not found"})
        return
    end

    res.json(messages[idx])
end)

# 5. Session State & Statistics
app.get("/session", fn(req, res)
    let visits = req.session.get("visits", 0) + 1
    req.session.set("visits", visits)

    res.json({
        "sessionId":      req.session.id(),
        "isNewSession":   req.session.isNew(),
        "visits":         visits,
        "allSessionData": req.session.all()
    })
end)

# Start server listener
app.listen()
