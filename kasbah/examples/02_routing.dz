# ═══════════════════════════════════════════════════════════════════════════════
# Kasbah Example 02 — Routing & Input Helpers
# ═══════════════════════════════════════════════════════════════════════════════
# Demonstrates route parameters (:param), query strings (?key=val), JSON/Form bodies,
# and fluent input helper methods (`param`, `query`, `input`, `all`, `only`, `except`).
#
# Usage:
#   Run: djazair examples/02_routing.dz
#   Endpoints:
#     GET  /users/5                 -> Extracts :id param ("5")
#     GET  /users/5/posts/99        -> Extracts multi-params (:id, :postId)
#     GET  /search?q=kasbah         -> Accesses query string parameter
#     GET  /inputs?name=john&age=25 -> Extracts unified inputs, only(), except()
#     POST /users                   -> Receives JSON or URL-encoded form body

use kasbah

# Initialize application instance with body parser enabled
let app = new kasbah.kasbahApp({
    "port": 8080,
    "bodyParser": True
})

# 1. Base route
app.get("/", fn(req, res)
    res.text("Kasbah Routing Demo — try /users/123 or /search?q=hello")
end)

# 2. Single dynamic parameter route
app.get("/users/:id", fn(req, res)
    res.json({
        "route":  "/users/:id",
        "userId": req.param("id"),
        "method": req.method
    })
end)

# 3. Multi-parameter nested route
app.get("/users/:id/posts/:postId", fn(req, res)
    res.json({
        "userId": req.param("id"),
        "postId": req.param("postId")
    })
end)

# 4. Query string extraction
app.get("/search", fn(req, res)
    let q = req.input("q")
    if isNull(q)
        res.status(400).json({"error": "Missing ?q= query parameter"})
    else
        res.json({"query": q, "results": ["result1", "result2"]})
    end
end)

# 5. Unified input helpers (`all`, `inputs`, `only`, `except`)
app.get("/inputs", fn(req, res)
    let allInputs = req.inputs()
    res.json({
        "allInputs": allInputs,
        "only":      req.only(["name", "page"]),
        "except":    req.except(["token"])
    })
end)

# 6. POST body handling
app.post("/users", fn(req, res)
    let name = req.input("name")
    if isNull(name) or name == ""
        res.status(400).json({"error": "Field 'name' is required"})
        return
    end
    res.status(201).json({
        "message": "User created successfully",
        "name":    name,
        "data":    req.body
    })
end)

# Start server listener
app.listen()
