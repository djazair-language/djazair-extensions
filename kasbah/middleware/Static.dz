# Kasbah Middleware — Static File Server
# Serves files from a configured root directory for GET requests only.
# Prevents path traversal by normalizing and verifying paths before serving.

use file
use path
import "../helpers/utils.dz" as * 

# Factory function that returns a static file serving middleware.
# `root` is the absolute or relative path to the directory to expose.
fn serveStatic(root)
    # Resolve and normalize the root once at startup, not per request
    let normRoot = path.normalize(root)
    # Lowercase version used for case-insensitive prefix checks (Windows safety)
    let normRootLower = normRoot.lower()

    return fn(req, res)
        # Only serve GET requests; ignore POST, PUT, etc.
        if req.method != "GET"
            return
        end

        let relPath = req.path
        # If root folder name (e.g. "public") matches URL prefix (e.g. "/public/style.css"),
        # strip the prefix so it resolves to "${normRoot}/style.css"
        let rootBase = path.basename(normRoot).lower()
        if rootBase != "" && relPath.lower().startsWith("/${rootBase}/")
            relPath = relPath.slice(rootBase.length() + 1)
        end

        # Build the candidate file path and normalize it to collapse ".." etc.
        let filePath = path.normalize("${normRoot}/${relPath}")
        let filePathLower = filePath.lower()

        # ── Path traversal guard ───────────────────────────────────────────────
        if filePathLower.slice(0, normRootLower.length()) != normRootLower
            return
        end

        if filePath.length() > normRoot.length()
            let sep = filePathLower[normRootLower.length()]
            if sep != "/" && sep != "\\"
                return
            end
        end

        # If path maps to a directory, try serving index.html inside it
        if file.isDir(filePath)
            let indexPath = path.normalize("${filePath}/index.html")
            if file.exists(indexPath)
                res.setHeader("Cache-Control", "no-cache")
                res.setHeader("Vary", "Accept-Encoding")
                res.file(indexPath)
            end
            return
        end

        # Skip paths that do not exist on disk
        if !file.exists(filePath)
            return
        end

        # Require a file extension so we can set a proper Content-Type
        let ext = path.extname(filePath).lower()
        if ext == ""
            return
        end

        # ── Cache-Control headers ─────────────────────────────────────────────
        let isImmutable = ext == ".js" || ext == ".css" || ext == ".woff"
                       || ext == ".woff2" || ext == ".ttf" || ext == ".otf"
                       || ext == ".png" || ext == ".jpg" || ext == ".jpeg"
                       || ext == ".gif" || ext == ".webp" || ext == ".svg"
                       || ext == ".ico"

        if isImmutable
            res.setHeader("Cache-Control", "public, max-age=86400, stale-while-revalidate=3600")
        else
            res.setHeader("Cache-Control", "no-cache")
        end

        res.setHeader("Vary", "Accept-Encoding")

        # Delegate to res.file which handles binary safe reading and MIME types
        res.file(filePath)
    end
end
