# Kasbah Middleware — BodyParser
# Parses JSON, URL-encoded, and multipart/form-data request bodies.

use json as *
use os
use file
use dir
use bytes
import "../helpers/utils.dz" as *

# Parses JSON payload into req.body map/array.
fn parseJson(req, res)
    if req.body == ""
        return
    end
    try
        req.body = decode(req.body)
    catch err
        res.status(400).json({"error": "Invalid JSON body"})
        return
    end
end

# Parses URL-encoded form data into req.body map.
fn parseUrlEncoded(req, res)
    let rawBody = req.body
    req.body = {}
    if rawBody != ""
        let parts = rawBody.split("&")
        for part in parts
            let eq = part.index("=")
            if eq != -1
                req.body[urlDecode(part.slice(0, eq))] = urlDecode(part.slice(eq + 1))
            elif part != ""
                req.body[urlDecode(part)] = ""
            end
        end
    end
end

# Parses multipart/form-data payload, extracting text fields and saving file uploads to temp storage.
fn parseMultipart(req, res, boundary, maxBodySize = 10)
    if boundary == "" || boundary.length() > 70 || boundary.contains("\r") || boundary.contains("\n")
        res.status(400).json({"error": "Missing boundary in multipart/form-data"})
        return
    end

    let boundaryChars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789'()+_,-./:=? "
    for c in boundary
        if !boundaryChars.contains(c)
            res.status(400).json({"error": "Invalid multipart boundary"})
            return
        end
    end

    let rawBody = req.body
    req.body = {}

    let boundaryPrefix = "--${boundary}"
    # RFC 7578 delimiters begin at the body start or after CRLF.  Splitting on
    # the bare boundary used to corrupt files that merely contained its text.
    if !rawBody.startsWith(boundaryPrefix)
        res.status(400).json({"error": "Malformed multipart body"})
        return
    end
    let bodyWithoutFirstBoundary = rawBody.slice(boundaryPrefix.length())
    if bodyWithoutFirstBoundary.startsWith("--")
        return
    end
    if bodyWithoutFirstBoundary.startsWith("\r\n")
        bodyWithoutFirstBoundary = bodyWithoutFirstBoundary.slice(2)
    else
        res.status(400).json({"error": "Malformed multipart body"})
        return
    end
    let parts = bodyWithoutFirstBoundary.split("\r\n${boundaryPrefix}")

    for part in parts
        let pLen = part.length()
        if pLen == 0 || part == "--\r\n" || part == "--\n" || part == "--" || part == "\r\n" || part == "\n"
            continue
        end

        let pStart = 0
        if pLen >= 2 && part.slice(0, 2) == "\r\n"
            pStart = 2
        elif pLen >= 1 && part.slice(0, 1) == "\n"
            pStart = 1
        end

        let cleanPart = part.slice(pStart)

        let byteArrAll = bytes.fromString(cleanPart)
        let headerEnd = -1
        let contentOffset = 4
        for i in 0 .. byteArrAll.length() - 4
            if byteArrAll[i] == 13 && byteArrAll[i+1] == 10 && byteArrAll[i+2] == 13 && byteArrAll[i+3] == 10
                headerEnd = i
                break
            end
        end
        if headerEnd == -1
            contentOffset = 2
            for i in 0 .. byteArrAll.length() - 2
                if byteArrAll[i] == 10 && byteArrAll[i+1] == 10
                    headerEnd = i
                    break
                end
            end
        end

        if headerEnd <= 0
            continue
        end

        let headerSection = bytes.toString(byteArrAll.slice(0, headerEnd))
        let contentSection = bytes.toString(byteArrAll.slice(headerEnd + contentOffset))

        let cdHeader = ""
        let ctHeader = "text/plain"

        let hLines = headerSection.split("\n")
        for hLine in hLines
            let hClean = hLine.strip()
            let hLower = hClean.lower()
            if hLower.length() >= 20 && hLower.slice(0, 20) == "content-disposition:"
                cdHeader = hClean.slice(20).strip()
            elif hLower.length() >= 13 && hLower.slice(0, 13) == "content-type:"
                ctHeader = hClean.slice(13).strip()
            end
        end

        let disp = parseContentDisposition(cdHeader)
        let name = disp["name"]
        let filename = sanitizeFilename(disp["filename"])

        if name == "" || name.length() > 128 || name.contains("\r") || name.contains("\n")
            continue
        end

        if filename != ""
            let byteArr = bytes.fromString(contentSection)
            let byteLimit = maxBodySize * 1024 * 1024
            if byteArr.length() > byteLimit
                res.status(413).json({
                    "error": "File too large",
                    "field": name,
                    "maxBytes": byteLimit
                })
                return
            end

            let tempDir = "${os.tmpDir()}/kasbah_uploads"
            if !file.exists(tempDir)
                dir.createAll(tempDir)
            end
            let tempPath = "${tempDir}/${generateId(32)}"
            file.writeBytes(tempPath, byteArr)

            let tracked = req.get("uploadedFiles")
            if isNull(tracked)
                req.set("uploadedFiles", [tempPath])
            else
                tracked.append(tempPath)
            end

            let fileInfo = {
                "name":     name,
                "filename": filename,
                "type":     ctHeader,
                "tempPath": tempPath,
                "size":     byteArr.length()
            }
            if req.files.has(name)
                if isArray(req.files[name])
                    req.files[name].append(fileInfo)
                else
                    req.files[name] = [req.files[name], fileInfo]
                end
            else
                req.files[name] = fileInfo
            end
        else
            req.body[name] = contentSection
        end
    end
end

# Creates a body parser middleware function with configurable max size limit.
fn bodyParser(maxBodySize = 10)
    return fn(req, res)
        if req.method == "GET" || req.method == "HEAD" || req.method == "OPTIONS"
            return
        end

        if bytes.fromString(req.body).length() > maxBodySize * 1024 * 1024
            res.status(413).text("Request body too large")
            return
        end

        let ct = req.header("content-type")
        if ct == ""
            return
        end

        let parts = ct.split(";")
        let mainType = parts[0].strip()

        if mainType == "application/json"
            parseJson(req, res)
        elif mainType == "application/x-www-form-urlencoded"
            parseUrlEncoded(req, res)
        elif mainType == "multipart/form-data"
            let parsedCt = parseContentType(ct)
            parseMultipart(req, res, parsedCt["boundary"], maxBodySize)
        end
    end
end
