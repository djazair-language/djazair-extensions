# Kasbah Middleware — Session
# Server-side session management with file-based storage.

use os
use file
use dir
use json
use regex
import "../helpers/utils.dz" as *
import "../helpers/cookie.dz" as *
import "../core/sessionManager.dz" as sm

class fileStore
    init(dirPath)
        self.storeDir = dirPath
        if !file.exists(dirPath)
            dir.createAll(dirPath)
        end
    end

    # Reads session JSON data from disk for a session ID.
    read(sid)
        let spath = "${self.storeDir}/${sid}.json"
        if !file.exists(spath)
            return {}
        end
        try
            let raw = file.read(spath)
            return json.decode(raw)
        catch err
            return {}
        end
    end

    # Writes session JSON data to disk for a session ID.
    write(sid, data)
        if data.keys().length() == 0
            self.destroy(sid)
            return
        end
        let spath = "${self.storeDir}/${sid}.json"
        try
            file.write(spath, json.encode(data))
        catch err
        end
    end

    # Deletes session JSON file from disk.
    destroy(sid)
        let spath = "${self.storeDir}/${sid}.json"
        try
            if file.exists(spath)
                file.delete(spath)
            end
        catch err
        end
    end
end

# Creates a session middleware function with file-backed storage and cookie rotation support.
fn session(options = {})
    let cookieName = "kasbah.sid"
    if options.has("name")
        cookieName = options["name"]
    end

    let sessionDir = "${os.tmpDir()}/kasbah_sessions"
    if options.has("dir")
        sessionDir = options["dir"]
    end

    let store = new fileStore(sessionDir)

    let maxAge = 86400
    if options.has("maxAge")
        maxAge = options["maxAge"]
    end

    return fn(req, res)
        let sid = Null

        let rawSid = req.cookies.get(cookieName)

        if !isNull(rawSid)
            let validSid = regex.fullMatch("[0-9a-f]+", rawSid)
            if !isNull(validSid)
                sid = rawSid
            end
        end

        let sessData = {}
        let isNew    = False

        if isNull(sid) || sid == ""
            sid   = generateId(32)
            isNew = True
            res.cookie(cookieName, sid, {
                "httpOnly": True,
                "path":     "/",
                "maxAge":   maxAge,
                "sameSite": "Lax"
            })
        else
            sessData = store.read(sid)
        end

        let mgr = new sm.sessionManager(sessData, sid, isNew)
        req.session = mgr
        res.session = mgr

        req.set("store", store)
        req.set("sid", sid)
    end
end
