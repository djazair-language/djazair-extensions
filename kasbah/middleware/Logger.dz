# Kasbah Middleware — Logger
# A class-based logger that centralizes request logs, error logs, and level filtering.

use datetime
import "../helpers/utils.dz" as *

class kasbahLogger
    init(options = {})
        let defaults = {
            "level":  "info",
            "format": "dev"
        }
        self.configMap = merge(defaults, options)
        self.levelsMap = {
            "debug": 10,
            "info":  20,
            "warn":  30,
            "error": 40,
            "none":  100
        }
        let levelName = self.configMap["level"].lower()
        if !self.levelsMap.has(levelName)
            levelName = "info"
        end
        self.currentLevel = self.levelsMap[levelName]
    end

    # Returns formatted timestamp string `[HH:MM:SS]`.
    timestampStr()
        let d = datetime.now()
        let h = str(d.hour())
        let m = str(d.minute())
        let s = str(d.second())
        if h.length() < 2
            h = "0${h}"
        end
        if m.length() < 2
            m = "0${m}"
        end
        if s.length() < 2
            s = "0${s}"
        end
        return "[${h}:${m}:${s}]"
    end

    # Core log dispatcher.
    logMsg(levelName, levelValue, msg)
        if levelValue >= self.currentLevel
            print("${self.timestampStr()} [${levelName.upper()}] ${msg}")
        end
    end

    # Logs debug message.
    debug(msg)
        self.logMsg("debug", self.levelsMap["debug"], msg)
    end

    # Logs info message.
    info(msg)
        self.logMsg("info", self.levelsMap["info"], msg)
    end

    # Logs warn message.
    warn(msg)
        self.logMsg("warn", self.levelsMap["warn"], msg)
    end

    # Logs error message.
    error(msg)
        self.logMsg("error", self.levelsMap["error"], msg)
    end

    # Lifecycle hook: called at request start to record timestamp and request metadata.
    onRequest(req)
        req.set("logStart", datetime.ticks())
        req.set("logMethod", req.method)
        req.set("logPath", req.path)
        req.set("logIp", req.ip)
    end

    # Lifecycle hook: called at request completion to log HTTP method, path, status, and duration.
    onComplete(req, res)
        if self.currentLevel > self.levelsMap["info"]
            return
        end

        let start = req.get("logStart")
        if isNull(start)
            return
        end

        let elapsed = (datetime.ticks() - start) / 1000
        let method  = req.get("logMethod")
        let url     = req.get("logPath")
        let status  = res.statusCode

        let msg = ""
        if self.configMap["format"] == "combined"
            let ip = req.get("logIp")
            msg = "${ip} ${method} ${url} ${status} ${elapsed}ms"
        else
            msg = "${method} ${url} ${status} ${elapsed}ms"
        end

        self.logMsg("info", 20, msg)
    end

    # Lifecycle hook: called when an error occurs during request processing.
    onError(req, err)
        let method = req.get("logMethod")
        if isNull(method)
            method = req.method
        end
        let url = req.get("logPath")
        if isNull(url)
            url = req.path
        end
        
        let msg = ""
        if self.configMap["format"] == "combined"
            let ip = req.get("logIp")
            if isNull(ip)
                ip = req.ip
            end
            msg = "${ip} ${method} ${url} -> ${str(err)}"
        else
            msg = "${method} ${url} -> ${str(err)}"
        end

        self.logMsg("error", 40, msg)
    end
end
