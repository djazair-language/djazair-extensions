# ═══════════════════════════════════════════════════════════════════════════════
# engine.dz — Qalam AST Template Engine
# ═══════════════════════════════════════════════════════════════════════════════
# Features:
# - Variable interpolation: `{{ var }}` (auto HTML escaped)
# - Unescaped HTML: `{{{ raw }}}`
# - Conditionals: `{% if cond %} ... {% else %} ... {% endif %}`
# - Loops: `{% for item in items %} ... {% endfor %}`
# - Template inheritance: `{% extends "layout" %}` and `{% block name %} ... {% endblock %}`
# - Partials / sub-views: `{% include "partials/nav" %}`
# - Security: Directory traversal prevention, XSS auto-escaping

use file
use path
use regex
import "escaper.dz" as *

class view
    # Initializes the template renderer with configuration options.
    #
    # @param config {Map} Configuration options:
    #                     - "views" {String} Base directory for template files
    init(config = {})
        self.configMap = config
    end

    # Resolves and validates absolute filesystem path for a template file.
    # Prevents directory traversal attacks (`../`).
    #
    # @param templateName {String} Template name/path (e.g. "trades/list")
    # @return             {String} Absolute normalized filesystem path
    getSafePath(templateName)
        let viewsDir = ""
        if self.configMap.has("views") and self.configMap["views"] != ""
            viewsDir = path.normalize(self.configMap["views"])
        else
            viewsDir = path.resolve("views")
        end

        if not templateName.contains(".")
            templateName = "${templateName}.html"
        end

        let safePath = path.normalize("${viewsDir}/${templateName}")
        let viewsDirLower = viewsDir.lower()
        if not viewsDirLower.endsWith("/") and not viewsDirLower.endsWith("\\")
            let okSlash = safePath.lower().startsWith("${viewsDirLower}/")
            let okBackslash = safePath.lower().startsWith("${viewsDirLower}\\")
            if not okSlash and not okBackslash
                throw "Forbidden template path traversal: ${templateName}"
            end
        else
            if not safePath.lower().startsWith(viewsDirLower)
                throw "Forbidden template path traversal: ${templateName}"
            end
        end
        return safePath
    end

    # Reads template source file from disk.
    #
    # @param templateName {String} Template path
    # @return             {String} Template file text content
    readFile(templateName)
        let safePath = self.getSafePath(templateName)
        if not file.exists(safePath)
            throw "Template not found: ${templateName}"
        end
        let content = ""
        let fh = file.open(safePath, "r")
        try
            content = fh.read()
        catch err
            throw "Error reading template file: ${templateName}"
        finally
            fh.close()
        end
        return content
    end

    # Tokenizes template string into AST token objects (TEXT, ESC, RAW, TAG).
    #
    # @param templateString {String} Raw template text
    # @return               {Array}  List of token maps
    tokenize(templateString)
        let pat = regex.compile("(\\{\\{\\{[^\\}]+\\}\\}\\}|\\{\\{[^\\}]+\\}\\}|\\{%[^%]+%\\})")
        let tokens = []
        let i = 0
        let len = templateString.length()

        while i < len
            let substr = templateString.slice(i)
            let m = pat.search(substr)
            if isNull(m)
                tokens.append({"type": "TEXT", "val": substr})
                break
            end

            let startIdx = m.start(0)
            let endIdx   = m.endPos(0)
            let tag      = m.group(0)

            if startIdx > 0
                tokens.append({"type": "TEXT", "val": substr.slice(0, startIdx)})
            end

            if tag.startsWith("{{{")
                tokens.append({"type": "RAW", "val": tag.slice(3, tag.length() - 3).strip()})
            elif tag.startsWith("{{")
                tokens.append({"type": "ESC", "val": tag.slice(2, tag.length() - 2).strip()})
            elif tag.startsWith("{%")
                tokens.append({"type": "TAG", "val": tag.slice(2, tag.length() - 2).strip()})
            end

            i = i + endIdx
        end
        return tokens
    end

    # Strips surrounding double or single quotation marks from a string literal.
    #
    # @param strVal {String} String literal with quotes
    # @return       {String} Clean string without surrounding quotes
    stripQuotes(strVal)
        let s = str(strVal).strip()
        if (s.startsWith("\"") and s.endsWith("\"")) or (s.startsWith("'") and s.endsWith("'"))
            if s.length() >= 2
                return s.slice(1, s.length() - 1)
            end
        end
        return s
    end

    # Parses flat token stream into a hierarchical AST node tree.
    #
    # @param tokens {Array} Token list from tokenize()
    # @param state  {Map}   Mutable index state `{"i": currentIndex}`
    # @return       {Array} AST node tree
    parseTokens(tokens, state)
        let nodes = []
        while state["i"] < tokens.length()
            let t = tokens[state["i"]]
            state["i"] = state["i"] + 1
            if t["type"] == "TEXT" or t["type"] == "ESC" or t["type"] == "RAW"
                nodes.append(t)
            elif t["type"] == "TAG"
                let val = t["val"]
                let tag = val
                let spaceIdx = val.index(" ")
                if spaceIdx != -1
                    tag = val.slice(0, spaceIdx)
                end

                if tag == "if"
                    let cond = val.slice(2).strip()
                    let trueNodes = self.parseTokens(tokens, state)
                    let falseNodes = []
                    let lastT = tokens[state["i"] - 1]
                    if lastT["type"] == "TAG" and lastT["val"].startsWith("else")
                        falseNodes = self.parseTokens(tokens, state)
                    end
                    nodes.append({"type": "IF", "cond": cond, "trueNodes": trueNodes, "falseNodes": falseNodes})
                elif tag == "else" or tag == "endif"
                    return nodes
                elif tag == "for"
                    let loopParts = val.slice(3).strip().split(" in ")
                    let varName = loopParts[0].strip()
                    let listName = loopParts[1].strip()
                    let bodyNodes = self.parseTokens(tokens, state)
                    nodes.append({"type": "FOR", "var": varName, "list": listName, "body": bodyNodes})
                elif tag == "endfor"
                    return nodes
                elif tag == "include"
                    let tplName = self.stripQuotes(val.slice(7).strip())
                    nodes.append({"type": "INCLUDE", "val": tplName})
                elif tag == "extends"
                    let tplName = self.stripQuotes(val.slice(7).strip())
                    nodes.append({"type": "EXTENDS", "val": tplName})
                elif tag == "block"
                    let bName = val.slice(5).strip()
                    let bodyNodes = self.parseTokens(tokens, state)
                    nodes.append({"type": "BLOCK", "name": bName, "body": bodyNodes})
                elif tag == "endblock"
                    return nodes
                end
            end
        end
        return nodes
    end

    # Evaluates a template variable expression with dot-notation on the data context.
    # Supports negation prefix `!` and nested dot paths like `user.profile.name`.
    #
    # @param expr {String} Expression string (e.g. "user.profile.name" or "!item.active")
    # @param data {Map}    Variable context map
    # @return     {Any}    Evaluated value
    evalExpr(expr, data)
        expr = expr.strip()
        let isNegated = False
        if expr.startsWith("!")
            isNegated = True
            expr = expr.slice(1).strip()
        end

        let parts = expr.split(".")
        let current = data
        for p in parts
            if isMap(current) and current.has(p)
                current = current[p]
            else
                current = Null
                break
            end
        end

        if isNegated
            if isNull(current) or current == False or current == 0 or current == ""
                return True
            end
            if isArray(current) and current.length() == 0
                return True
            end
            return False
        end
        return current
    end

    # Evaluates an AST node list recursively and produces the output HTML string.
    #
    # @param nodes     {Array} AST node list
    # @param data      {Map}   Template context variables
    # @param blocksMap {Map}   Block overrides map for template inheritance
    # @return          {String} Rendered HTML string
    evalNodes(nodes, data, blocksMap)
        let out = ""
        for n in nodes
            if n["type"] == "TEXT"
                out += n["val"]
            elif n["type"] == "ESC"
                let val = self.evalExpr(n["val"], data)
                if not isNull(val)
                    out += escapeHtml(str(val))
                end
            elif n["type"] == "RAW"
                let val = self.evalExpr(n["val"], data)
                if not isNull(val)
                    out += str(val)
                end
            elif n["type"] == "IF"
                let condVal = self.evalExpr(n["cond"], data)
                let isTruthy = False
                if not isNull(condVal) and condVal != False and condVal != 0 and condVal != ""
                    if not isArray(condVal) or condVal.length() > 0
                        isTruthy = True
                    end
                end
                if isTruthy
                    out += self.evalNodes(n["trueNodes"], data, blocksMap)
                else
                    out += self.evalNodes(n["falseNodes"], data, blocksMap)
                end
            elif n["type"] == "FOR"
                let listVal = self.evalExpr(n["list"], data)
                if isArray(listVal)
                    for item in listVal
                        let localData = {}
                        for k, v in data
                            localData[k] = v
                        end
                        localData[n["var"]] = item
                        out += self.evalNodes(n["body"], localData, blocksMap)
                    end
                end
            elif n["type"] == "INCLUDE"
                out += self.render(n["val"], data)
            elif n["type"] == "BLOCK"
                let bName = n["name"]
                if blocksMap.has(bName)
                    out += self.evalNodes(blocksMap[bName], data, blocksMap)
                else
                    out += self.evalNodes(n["body"], data, blocksMap)
                end
            end
        end
        return out
    end

    # Extracts named `{% block %}` definitions from a child template for layout inheritance.
    #
    # @param nodes     {Array} AST node list
    # @param blocksMap {Map}   Target map to populate with block name to nodes
    extractBlocks(nodes, blocksMap)
        for n in nodes
            if n["type"] == "BLOCK"
                blocksMap[n["name"]] = n["body"]
            end
        end
    end

    # Reads, parses, and renders a template file with a data context.
    #
    # @param templateName {String} Template path name (e.g. "home" or "trades/list")
    # @param data         {Map}    Template variables
    # @return             {String} Rendered HTML string
    render(templateName, data = {})
        let content = self.readFile(templateName)
        let tokens = self.tokenize(content)
        let state = {"i": 0}
        let nodes = self.parseTokens(tokens, state)

        let extendsNode = Null
        for n in nodes
            if n["type"] == "EXTENDS"
                extendsNode = n
                break
            end
        end

        if not isNull(extendsNode)
            let blocksMap = {}
            self.extractBlocks(nodes, blocksMap)
            let parentContent = self.readFile(extendsNode["val"])
            let parentTokens = self.tokenize(parentContent)
            let pState = {"i": 0}
            let parentNodes = self.parseTokens(parentTokens, pState)
            return self.evalNodes(parentNodes, data, blocksMap)
        else
            let emptyMap = {}
            return self.evalNodes(nodes, data, emptyMap)
        end
    end

    # Parses and renders an in-memory template string directly with a data context.
    # Does not require a template file on disk.
    #
    # @param templateString {String} Raw template text
    # @param data           {Map}    Template variables
    # @param blocksMap      {Map}    Optional block overrides for inheritance
    # @return               {String} Rendered HTML string
    renderString(templateString, data = {}, blocksMap = {})
        let tokens = self.tokenize(templateString)
        let state = {"i": 0}
        let nodes = self.parseTokens(tokens, state)
        return self.evalNodes(nodes, data, blocksMap)
    end
end
