# 01_basic.dz — Basic clipboard operations
use clipboard

print("Has: ${clipboard.has()}")
print("Paste: '${clipboard.paste()}'")

clipboard.copy("Hello from Djazair!")
print("After copy - has: ${clipboard.has()}")
print("Paste: '${clipboard.paste()}'")

clipboard.clear()
print("After clear - has: ${clipboard.has()}")
print("Paste: '${clipboard.paste()}'")
